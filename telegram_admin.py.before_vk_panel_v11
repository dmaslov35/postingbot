VK_WORKER_DIR = Path(
    os.environ.get("VK_WORKER_DIR", "/opt/vkbot")
)

VK_WORKER_STATE_FILES = [
    VK_WORKER_DIR / "vk_worker_final_state.json",
    VK_WORKER_DIR / "vk_worker_v3_state.json",
]

VK_WORKER_LOG_FILES = [
    VK_WORKER_DIR / "vk_worker_final.log",
    VK_WORKER_DIR / "vk_worker_v3.log",
]


def _vk_worker_existing(paths):
    for path in paths:
        try:
            if path.exists():
                return path
        except Exception:
            pass

    return None


def _vk_worker_load_json(path):
    if path is None:
        return None

    try:
        with path.open(
            "r",
            encoding="utf-8",
        ) as f:
            return json.load(f)
    except Exception:
        return None


def _vk_worker_rows(data):
    if not isinstance(data, dict):
        return []

    # Поддерживаем несколько форматов state-файлов.
    for key in (
        "groups",
        "states",
        "items",
        "results",
    ):
        value = data.get(key)

        if isinstance(value, dict):
            rows = []

            for url, item in value.items():
                if not isinstance(item, dict):
                    continue

                row = dict(item)
                row.setdefault("url", url)
                rows.append(row)

            return rows

        if isinstance(value, list):
            return [
                item
                for item in value
                if isinstance(item, dict)
            ]

    # Некоторые версии worker хранят:
    # URL -> state прямо в корне JSON.
    rows = []

    for url, item in data.items():
        if (
            isinstance(url, str)
            and url.startswith("http")
            and isinstance(item, dict)
        ):
            row = dict(item)
            row.setdefault("url", url)
            rows.append(row)

    return rows


def vk_worker_status_text():
    state_path = _vk_worker_existing(
        VK_WORKER_STATE_FILES
    )

    log_path = _vk_worker_existing(
        VK_WORKER_LOG_FILES
    )

    state_data = _vk_worker_load_json(
        state_path
    )

    rows = _vk_worker_rows(
        state_data
    )

    subscribed = 0
    not_subscribed = 0
    unknown = 0
    create_count = 0
    suggest_count = 0

    for row in rows:
        subscription = str(
            row.get("subscription")
            or row.get("subscription_state")
            or ""
        ).upper()

        if subscription == "SUBSCRIBED":
            subscribed += 1

        elif subscription == "NOT_SUBSCRIBED":
            not_subscribed += 1

        elif subscription:
            unknown += 1

        if row.get("create") is True:
            create_count += 1

        if row.get("suggest") is True:
            suggest_count += 1

    lines = [
        "🤖 VK Worker",
        "",
        "🔒 Production: ЗАБЛОКИРОВАН",
        "🛡 Публикация из Telegram: ОТКЛЮЧЕНА",
        "🛡 Подписки из Telegram: ОТКЛЮЧЕНЫ",
        "🛡 Join-заявки из Telegram: ОТКЛЮЧЕНЫ",
        "",
    ]

    if state_path is None:
        lines.append(
            "📊 State-файл worker пока "
            "не найден на сервере."
        )

    else:
        try:
            modified = datetime.fromtimestamp(
                state_path.stat().st_mtime
            ).strftime(
                "%d.%m.%Y %H:%M:%S"
            )

        except Exception:
            modified = "неизвестно"

        lines.append(
            f"📊 State: {state_path.name}"
        )

        lines.append(
            f"🕒 Обновлён: {modified}"
        )

        if rows:
            lines.extend([
                f"📋 Групп: {len(rows)}",
                f"🟢 Подписаны: {subscribed}",
                (
                    "⚪ Не подписаны: "
                    f"{not_subscribed}"
                ),
                (
                    "❓ Неопределённо: "
                    f"{unknown}"
                ),
                f"📝 CREATE: {create_count}",
                f"📨 SUGGEST: {suggest_count}",
            ])

        else:
            lines.append(
                "ℹ️ State найден, но список "
                "групп не распознан."
            )

    lines.append("")

    if log_path is None:
        lines.append(
            "📈 Worker log: пока не найден"
        )

    else:
        lines.append(
            f"📈 Worker log: {log_path.name}"
        )

    lines.extend([
        "",
        "ℹ️ Сейчас этот раздел работает "
        "только на чтение.",
        "",
        "Никаких действий в VK эта "
        "панель не выполняет.",
    ])

    return "\n".join(lines)


def vk_worker_log_text():
    path = _vk_worker_existing(
        VK_WORKER_LOG_FILES
    )

    if path is None:
        return (
            "📈 Лог VK Worker пока "
            "не найден на сервере."
        )

    try:
        with path.open(
            "r",
            encoding="utf-8",
            errors="replace",
        ) as f:
            lines = f.readlines()

        tail = "".join(
            lines[-20:]
        ).strip()

    except Exception as exc:
        return (
            "❌ Не удалось прочитать "
            "worker log.\n\n"
            f"Ошибка: {type(exc).__name__}"
        )

    if not tail:
        tail = "(лог пуст)"

    # Не превышаем безопасный размер
    # сообщения Telegram.
    if len(tail) > 3200:
        tail = tail[-3200:]

    return (
        f"📈 Последние строки "
        f"{path.name}\n\n"
        f"{tail}"

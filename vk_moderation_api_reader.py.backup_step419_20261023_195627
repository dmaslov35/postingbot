#!/usr/bin/env python3
"""Чтение конкретной записи VK API без публикации и удаления."""

from pathlib import Path

from vk_post_identity import extract_post_identity


STOP = Path("/opt/vkbot/runtime/production.stop")


def read_vk_post(vk, post_url):
    """Получает одну запись через wall.getById.

    vk — заранее созданный VK API-клиент.
    """
    if not STOP.is_file():
        raise RuntimeError("PRODUCTION_STOP_REQUIRED")

    identity = extract_post_identity(post_url)

    if identity is None:
        return {
            "found": False,
            "reason": "INVALID_POST_URL",
            "authorship_verified": False,
            "deletion_allowed": False,
        }

    response = vk.wall.getById(
        posts=identity["vk_post_id"]
    )

    if not STOP.is_file():
        raise RuntimeError("PRODUCTION_STOP_REMOVED")

    if not isinstance(response, list) or len(response) != 1:
        return {
            "found": False,
            "reason": "POST_NOT_FOUND",
            "authorship_verified": False,
            "deletion_allowed": False,
        }

    post = response[0]

    if not isinstance(post, dict):
        raise RuntimeError("INVALID_API_RESPONSE")

    try:
        owner_id = int(post.get("owner_id"))
        post_id = int(post.get("id"))
    except (TypeError, ValueError):
        raise RuntimeError("INVALID_POST_ID")

    expected_id = identity["vk_post_id"]
    actual_id = f"{owner_id}_{post_id}"

    if actual_id != expected_id:
        raise RuntimeError("POST_ID_MISMATCH")

    actual_text = post.get("text")

    if not isinstance(actual_text, str):
        actual_text = ""

    return {
        "found": True,
        "reason": "POST_FOUND_UNVERIFIED",
        "vk_post_id": actual_id,
        "post_url": identity["post_url"],
        "actual_text": actual_text,
        "authorship_verified": False,
        "deletion_allowed": False,
    }

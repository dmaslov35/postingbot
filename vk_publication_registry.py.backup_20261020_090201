import sqlite3
from pathlib import Path

DEFAULT_DB = Path("/opt/vkbot/runtime/publications.sqlite3")

SCHEMA = """
CREATE TABLE IF NOT EXISTS publications (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    queue_id INTEGER,
    account_id INTEGER,
    group_url TEXT NOT NULL,
    flow TEXT NOT NULL CHECK(flow IN ('CREATE', 'SUGGEST')),
    vk_post_id TEXT,
    post_url TEXT,
    state TEXT NOT NULL CHECK(state IN (
        'SUBMITTED',
        'PENDING_MODERATION',
        'PUBLISHED',
        'REVIEW_REQUIRED',
        'DELETE_DUE',
        'DELETED',
        'DELETE_FAILED'
    )),
    published_at TEXT,
    delete_after TEXT,
    deleted_at TEXT,
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CHECK(state != 'PUBLISHED' OR (
        vk_post_id IS NOT NULL
        AND post_url IS NOT NULL
        AND published_at IS NOT NULL
    ))
);
CREATE UNIQUE INDEX IF NOT EXISTS idx_publication_queue
ON publications(queue_id)
WHERE queue_id IS NOT NULL;
CREATE UNIQUE INDEX IF NOT EXISTS idx_publication_vk_id
ON publications(vk_post_id)
WHERE vk_post_id IS NOT NULL;
"""

NETWORK_CANDIDATES_SCHEMA = "\nCREATE TABLE IF NOT EXISTS network_post_candidates (\n id INTEGER PRIMARY KEY AUTOINCREMENT,\n queue_id INTEGER NOT NULL,\n account_id INTEGER NOT NULL,\n vk_post_id INTEGER NOT NULL CHECK(vk_post_id > 0),\n source TEXT NOT NULL CHECK(source='VK_API_WALL_POST'),\n verified INTEGER NOT NULL DEFAULT 0 CHECK(verified=0),\n discovered_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,\n UNIQUE(queue_id, account_id, vk_post_id)\n);\n"

def connect(db_path=DEFAULT_DB):
    path = Path(db_path)
    path.parent.mkdir(parents=True, exist_ok=True)
    connection = sqlite3.connect(str(path))
    connection.row_factory = sqlite3.Row
    connection.execute("PRAGMA busy_timeout=5000")
    connection.executescript(SCHEMA)

    connection.execute("""
        CREATE TABLE IF NOT EXISTS post_candidates (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            queue_id INTEGER NOT NULL,
            vk_post_id TEXT NOT NULL,
            post_url TEXT NOT NULL,
            verified INTEGER NOT NULL DEFAULT 0
                CHECK(verified = 0),
            discovered_at TEXT NOT NULL
                DEFAULT CURRENT_TIMESTAMP,
            UNIQUE(queue_id, vk_post_id)
        )
    """)
    connection.executescript(NETWORK_CANDIDATES_SCHEMA)
    return connection

def register_attempt(
    queue_id, account_id, group_url, flow,
    state="REVIEW_REQUIRED", db_path=DEFAULT_DB
):
    if state not in (
        "SUBMITTED", "PENDING_MODERATION", "REVIEW_REQUIRED"
    ):
        raise ValueError("Invalid initial state")

    with connect(db_path) as db:
        cursor = db.execute("""
            INSERT INTO publications
            (queue_id, account_id, group_url, flow, state)
            VALUES (?, ?, ?, ?, ?)
            ON CONFLICT(queue_id) WHERE queue_id IS NOT NULL
            DO NOTHING
        """, (queue_id, account_id, group_url, flow, state))
        if cursor.rowcount != 1:
            raise RuntimeError("PUBLICATION_ATTEMPT_ALREADY_REGISTERED")

def confirm_publication(
    queue_id, vk_post_id, post_url,
    published_at, delete_after=None, db_path=DEFAULT_DB
):
    raise RuntimeError('Автоматическое подтверждение публикации заблокировано: нет проверенного доказательства авторства')
    if not vk_post_id or not post_url or not published_at:
        raise ValueError("Publication proof is incomplete")

    with connect(db_path) as db:
        cursor = db.execute("""
            UPDATE publications
            SET vk_post_id=?, post_url=?,
                published_at=?, delete_after=?,
                state='PUBLISHED',
                updated_at=CURRENT_TIMESTAMP
            WHERE queue_id=?
              AND state IN (
                'SUBMITTED', 'PENDING_MODERATION',
                'REVIEW_REQUIRED'
              )
        """, (
            vk_post_id, post_url, published_at,
            delete_after, queue_id
        ))
        if cursor.rowcount != 1:
            raise ValueError("Publication not found or invalid state")

def get_due_deletions(db_path=DEFAULT_DB):
    with connect(db_path) as db:
        rows = db.execute("""
            SELECT * FROM publications
            WHERE state='PUBLISHED'
              AND delete_after IS NOT NULL
              AND delete_after <= CURRENT_TIMESTAMP
              AND vk_post_id IS NOT NULL
              AND post_url IS NOT NULL
            ORDER BY delete_after, id
        """).fetchall()
        return [dict(row) for row in rows]


def save_post_candidates(
    queue_id, candidates, db_path=DEFAULT_DB
):
    """Сохраняет только кандидатов, не подтверждая публикацию."""
    from vk_post_identity import extract_post_identity

    if not isinstance(candidates, list):
        return 0

    valid = {}

    for candidate in candidates[:100]:
        if not isinstance(candidate, dict):
            continue

        url = candidate.get("post_url")
        identity = extract_post_identity(url)

        if identity:
            valid[identity["vk_post_id"]] = identity

    with connect(db_path) as db:
        db.execute("""
            CREATE TABLE IF NOT EXISTS post_candidates (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                queue_id INTEGER NOT NULL,
                vk_post_id TEXT NOT NULL,
                post_url TEXT NOT NULL,
                verified INTEGER NOT NULL DEFAULT 0
                    CHECK(verified = 0),
                discovered_at TEXT NOT NULL
                    DEFAULT CURRENT_TIMESTAMP,
                UNIQUE(queue_id, vk_post_id)
            )
        """)

        for identity in valid.values():
            db.execute("""
                INSERT OR IGNORE INTO post_candidates
                (queue_id, vk_post_id, post_url)
                VALUES (?, ?, ?)
            """, (
                queue_id,
                identity["vk_post_id"],
                identity["post_url"]
            ))

    return len(valid)


def save_network_post_candidates(
    queue_id, account_id, candidates, db_path=DEFAULT_DB
):
    """Сохраняет неподтверждённые post_id из сетевых ответов VK."""

    if type(queue_id) is not int or queue_id <= 0:
        raise ValueError("Invalid queue_id")

    if type(account_id) is not int or account_id <= 0:
        raise ValueError("Invalid account_id")

    if not isinstance(candidates, list):
        raise ValueError("Candidates must be a list")

    valid = sorted({
        post_id
        for post_id in candidates[:100]
        if type(post_id) is int and post_id > 0
    })

    if not valid:
        return 0

    with connect(db_path) as db:
        # Никаких изменений состояния публикации.
        for post_id in valid:
            db.execute("""
                INSERT OR IGNORE INTO network_post_candidates
                (queue_id, account_id, vk_post_id, source, verified)
                VALUES (?, ?, ?, 'VK_API_WALL_POST', 0)
            """, (queue_id, account_id, post_id))

    return len(valid)


def save_network_proof_assessment(
    queue_id, account_id, reason, post_id=None, db_path=DEFAULT_DB
):
    """Сохраняет оценку сетевых доказательств без подтверждения публикации."""

    if type(queue_id) is not int or queue_id <= 0:
        raise ValueError("Invalid queue_id")

    if type(account_id) is not int or account_id <= 0:
        raise ValueError("Invalid account_id")

    if not isinstance(reason, str) or not reason or len(reason) > 200:
        raise ValueError("Invalid proof reason")

    if post_id is not None:
        if type(post_id) is not int or post_id <= 0:
            raise ValueError("Invalid post_id")

    with connect(db_path) as db:
        db.execute("""
            CREATE TABLE IF NOT EXISTS network_proof_assessments (
                queue_id INTEGER PRIMARY KEY,
                account_id INTEGER NOT NULL,
                reason TEXT NOT NULL,
                vk_post_id INTEGER,
                verified INTEGER NOT NULL DEFAULT 0
                    CHECK(verified = 0),
                deletion_authorized INTEGER NOT NULL DEFAULT 0
                    CHECK(deletion_authorized = 0),
                assessed_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
            )
        """)

        existing = db.execute("""
            SELECT account_id
            FROM network_proof_assessments
            WHERE queue_id = ?
        """, (queue_id,)).fetchone()

        if existing is not None:
            raise RuntimeError("NETWORK_PROOF_ALREADY_RECORDED")

        db.execute("""
            INSERT INTO network_proof_assessments
            (queue_id, account_id, reason, vk_post_id,
             verified, deletion_authorized)
            VALUES (?, ?, ?, ?, 0, 0)
        """, (queue_id, account_id, reason, post_id))

    return True

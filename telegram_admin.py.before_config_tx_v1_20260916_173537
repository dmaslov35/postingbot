def load_config_fresh():
    """Всегда читает актуальный config.json."""
    with open('config.json', 'r', encoding='utf-8') as f:
        return json.load(f)


def save_config_atomic(new_config):
    """Атомарно сохраняет config.json и не оставляет временный файл."""
    import tempfile

    config_path = os.path.abspath('config.json')
    config_dir = os.path.dirname(config_path)

    fd, tmp_path = tempfile.mkstemp(
        prefix='.config.',
        suffix='.tmp',
        dir=config_dir,
        text=True,
    )

    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            json.dump(
                new_config,
                f,
                ensure_ascii=False,
                indent=2,
            )
            f.flush()
            os.fsync(f.fileno())

        os.chmod(tmp_path, 0o600)
        os.replace(tmp_path, config_path)
        os.chmod(config_path, 0o600)

    except Exception:
        try:
            os.unlink(tmp_path)
        except FileNotFoundError:
            pass
        raise


def get_pending_posts_for_account(user_id):
    """
    Возвращает количество незавершённых публикаций,
    принадлежащих VK-аккаунту.

    Никаких VK API вызовов здесь нет.
    """
    if user_id is None:
        # Fail closed:
        # malformed account must never be considered
        # safe for hard deletion.
        return -1

    try:
        with open(
            'published_posts.json',
            'r',
            encoding='utf-8',
        ) as f:
            posts = json.load(f)
    except FileNotFoundError:
        return 0
    except Exception:
        # При повреждённой/нечитаемой очереди выбираем
        # безопасный вариант: удаление аккаунта запрещаем.
        return -1

    if not isinstance(posts, list):
        return -1

    target = str(user_id)
    count = 0

    for post in posts:
        if not isinstance(post, dict):
            continue

        if str(post.get('account_user_id')) != target:
            continue

        status = str(
            post.get('status', 'pending')
        ).lower()

        if status not in {
            'deleted',
            'not_found',
        }:
            count += 1

    return count



                    "для штатных VK API операций.\n\n"
                    "Продолжить?"
                )

                keyboard = [
                    [
                        InlineKeyboardButton(
                            "▶️ Да, включить",
                            callback_data=(
                                f'account_enable_confirm_{index}'
                            ),
                        )
                    ],
                    [
                        InlineKeyboardButton(
                            "◀️ Отмена",
                            callback_data=f'account_view_{index}',
                        )
                    ],
                ]

                await query.message.edit_text(
                    text,
                    reply_markup=InlineKeyboardMarkup(
                        keyboard
                    ),
                )

    elif query.data.startswith(
        'account_enable_confirm_'
    ):
        index = int(query.data.rsplit('_', 1)[-1])

        cfg = load_config_fresh()
        accounts = cfg.get('vk_accounts', [])

        if index < 0 or index >= len(accounts):
            await show_accounts_menu(query)

        else:
            account = accounts[index]

            ready, errors = validate_account_for_enable(
                account
            )

            if not ready:
                # Между подтверждением и нажатием кнопки
                # config.json мог измениться.
                # Поэтому обязательно проверяем ещё раз.
                account['enabled'] = False
                save_config_atomic(cfg)

                reason_text = '\n'.join(
                    f"• {reason}"
                    for reason in errors
                )

                text = (
                    "❌ Аккаунт не включён.\n\n"
                    "Повторная проверка не пройдена:\n"
                    f"{reason_text}\n\n"
                    "Аккаунт оставлен отключённым."
                )

                keyboard = [[
                    InlineKeyboardButton(
                        "◀️ К аккаунту",
                        callback_data=f'account_view_{index}',
                    )
                ]]

                await query.message.edit_text(
                    text,
                    reply_markup=InlineKeyboardMarkup(
                        keyboard
                    ),
                )

            else:
                account['enabled'] = True
                save_config_atomic(cfg)

                user_id = account.get(
                    'user_id',
                    'не указан',
                )

                text = (
                    "🟢 Аккаунт включён.\n\n"
                    f"ID: {user_id}\n\n"
                    "Основной бот увидит изменение "
                    "через hot reload."
                )

                keyboard = [[
                    InlineKeyboardButton(
                        "◀️ К аккаунту",
                        callback_data=f'account_view_{index}',
                    )
                ]]

                await query.message.edit_text(
                    text,
                    reply_markup=InlineKeyboardMarkup(
                        keyboard
                    ),
                )

    elif query.data.startswith('account_delete_ask_'):
        index = int(query.data.rsplit('_', 1)[-1])
        accounts = get_vk_accounts()

        if index < 0 or index >= len(accounts):
            await show_accounts_menu(query)
        else:
            account = accounts[index]
            user_id = account.get('user_id', 'не указан')

            text = (
                "⚠️ Удаление VK-аккаунта\n\n"
                f"Аккаунт #{index + 1}\n"
                f"ID: {user_id}\n\n"
                "Удалить его из рабочей конфигурации?"
            )

            keyboard = [
                [
                    InlineKeyboardButton(
                        "🗑 Да, удалить",
                        callback_data=f'account_delete_confirm_{index}',
                    )
                ],
                [
                    InlineKeyboardButton(
                        "◀️ Отмена",
                        callback_data=f'account_view_{index}',
                    )
                ],
            ]

            await query.message.edit_text(
                text,
                reply_markup=InlineKeyboardMarkup(keyboard),
            )

    elif query.data.startswith('account_delete_confirm_'):
        index = int(query.data.rsplit('_', 1)[-1])

        cfg = load_config_fresh()
        accounts = cfg.get('vk_accounts', [])

        if 0 <= index < len(accounts):
            account = accounts[index]
            user_id = account.get('user_id')

            pending_count = get_pending_posts_for_account(
                user_id
            )

            if pending_count == -1:
                text = (
                    "❌ Удаление запрещено.\n\n"
                    "Не удалось безопасно проверить "
                    "очередь публикаций.\n\n"
                    "Аккаунт оставлен в конфигурации."
                )

                keyboard = [[
                    InlineKeyboardButton(
                        "◀️ К аккаунту",
                        callback_data=f'account_view_{index}',
                    )
                ]]

                await query.message.edit_text(
                    text,
                    reply_markup=InlineKeyboardMarkup(
                        keyboard
                    ),
                )

            elif pending_count > 0:
                # Сразу отключаем аккаунт, но НЕ удаляем его.
                accounts[index]['enabled'] = False
                save_config_atomic(cfg)

                text = (
                    "🛡 Удаление заблокировано.\n\n"
                    f"За аккаунтом числится "
                    f"незавершённых публикаций: "
                    f"{pending_count}.\n\n"
                    "Аккаунт автоматически отключён, "
                    "но сохранён в конфигурации.\n"
                    "Удалить его можно будет после "
                    "очистки очереди публикаций."
                )

                keyboard = [[
                    InlineKeyboardButton(
                        "◀️ К аккаунту",
                        callback_data=f'account_view_{index}',
                    )
                ]]

                await query.message.edit_text(
                    text,
                    reply_markup=InlineKeyboardMarkup(
                        keyboard
                    ),
                )

            else:
                removed = accounts.pop(index)
                save_config_atomic(cfg)

                removed_id = removed.get(
                    'user_id',
                    'не указан',
                )

                text = (
                    "✅ Аккаунт удалён из рабочей "
                    "конфигурации.\n\n"
                    f"ID: {removed_id}"
                )

                keyboard = [[
                    InlineKeyboardButton(
                        "◀️ К аккаунтам",
                        callback_data='accounts',
                    )
                ]]

                await query.message.edit_text(
                    text,
                    reply_markup=InlineKeyboardMarkup(
                        keyboard
                    ),
                )

        else:
            await show_accounts_menu(query)

    elif query.data == 'account_add':
        # SAFE ACCOUNT WIZARD V1
        # Черновик хранится только в context.user_data.
        # config.json здесь НЕ изменяется.
        context.user_data.pop(
            'vk_account_draft',
            None,
        )
        
        context.user_data[
            'vk_account_draft'
        ] = {}
        
        context.user_data[
            'action'
        ] = 'account_add_user_id'
        
        text = (
            "➕ Новый VK-аккаунт — шаг 1/2\n\n"
            "Отправьте числовой VK ID аккаунта.\n\n"
            "Пример: 123456789\n\n"
            "⚠️ Создаётся только временный "
            "черновик.\n"
            "config.json не изменяется.\n"
            "VK API не вызывается."
        )
        
        keyboard = [[
            InlineKeyboardButton(
                "❌ Отмена",
                callback_data='account_add_cancel',
            )
        ]]
        
        await query.message.edit_text(
            text,
            reply_markup=InlineKeyboardMarkup(
                keyboard
            ),
        )
    elif query.data == 'account_add_cancel':
        context.user_data.pop(
            'vk_account_draft',
            None,
        )

        context.user_data.pop(
            'action',
            None,
        )

        text = (
            "❌ Добавление отменено.\n\n"
            "Черновик удалён.\n"
            "Рабочая конфигурация не изменялась."
        )

        keyboard = [[
            InlineKeyboardButton(
                "◀️ К аккаунтам",
                callback_data='accounts',
            )
        ]]

        await query.message.edit_text(
            text,
            reply_markup=InlineKeyboardMarkup(
                keyboard
            ),
        )

    elif query.data == 'account_add_save':
        # SAFE SAVE V1
        # This handler never calls VK API.
        draft = context.user_data.get(
            'vk_account_draft'
        )

        if not isinstance(draft, dict):
            text = (
                "❌ Черновик не найден.\n\n"
                "Ничего не сохранено."
            )

            keyboard = [[
                InlineKeyboardButton(
                    "◀️ К аккаунтам",
                    callback_data='accounts',
                )
            ]]

            await query.message.edit_text(
                text,
                reply_markup=InlineKeyboardMarkup(
                    keyboard
                ),
            )
            return

        raw_user_id = draft.get('user_id')
        phone = draft.get('phone')

        try:
            user_id = int(raw_user_id)
        except (TypeError, ValueError):
            user_id = 0

        if user_id <= 0:
            await query.message.edit_text(
                "❌ Черновик содержит "
                "некорректный VK ID.\n\n"
                "Аккаунт НЕ сохранён."
            )
            return

        if (
            not isinstance(phone, str)
            or not phone.strip()
            or len(phone.strip()) > 40
        ):
            await query.message.edit_text(
                "❌ Черновик содержит "
                "некорректный телефон.\n\n"
                "Аккаунт НЕ сохранён."
            )
            return

        phone = phone.strip()

        try:
            cfg = load_config_fresh()
            accounts = cfg.get(
                'vk_accounts',
                [],
            )

            if not isinstance(accounts, list):
                raise ValueError(
                    "vk_accounts is not a list"
                )

        except Exception:
            await query.message.edit_text(
                "❌ Не удалось безопасно прочитать "
                "рабочую конфигурацию.\n\n"
                "Аккаунт НЕ сохранён."
            )
            return

        # Repeat duplicate check immediately before write.
        duplicate = any(
            isinstance(account, dict)
            and str(
                account.get('user_id')
            ) == str(user_id)
            for account in accounts
        )

        if duplicate:
            context.user_data.pop(
                'vk_account_draft',
                None,
            )
            context.user_data.pop(
                'action',
                None,
            )

            text = (
                "❌ Аккаунт с таким VK ID "
                "уже существует.\n\n"
                "Дубликат НЕ создан."
            )

            keyboard = [[
                InlineKeyboardButton(
                    "👥 К аккаунтам",
                    callback_data='accounts',
                )
            ]]

            await query.message.edit_text(
                text,
                reply_markup=InlineKeyboardMarkup(
                    keyboard
                ),
            )
            return

        # Security invariant:
        # Telegram can only create a DISABLED account
        # with EMPTY token.
        new_account = {
            'user_id': user_id,
            'phone': phone,
            'token': '',
            'enabled': False,
        }

        accounts.append(new_account)

        try:
            save_config_atomic(cfg)
        except Exception:
            await query.message.edit_text(
                "❌ Ошибка безопасного сохранения.\n\n"
                "Аккаунт НЕ активирован."
            )
            return

        context.user_data.pop(
            'vk_account_draft',
            None,
        )
        context.user_data.pop(
            'action',
            None,
        )

        saved_index = len(accounts) - 1

        text = (
            "✅ VK-аккаунт сохранён.\n\n"
            f"🆔 VK ID: {user_id}\n"
            f"📞 Телефон: {phone}\n"
            "⏸️ Статус: ОТКЛЮЧЁН\n"
            "🔐 Токен: НЕ УСТАНОВЛЕН\n\n"
            "Основной бот НЕ может использовать "
            "этот аккаунт.\n"
            "VK API не вызывался."
        )

        keyboard = [
            [
                InlineKeyboardButton(
                    "👤 Открыть аккаунт",
                    callback_data=(
                        f'account_view_{saved_index}'
                    ),
                )
            ],
            [
                InlineKeyboardButton(
                    "👥 К аккаунтам",
                    callback_data='accounts',
                )
            ],
        ]

        await query.message.edit_text(
            text,
            reply_markup=InlineKeyboardMarkup(
                keyboard
            ),
        )

    elif query.data == 'account_add_discard':
        context.user_data.pop(
            'vk_account_draft',
            None,
        )

        context.user_data.pop(
            'action',
            None,
        )

        text = (
            "🗑 Черновик удалён.\n\n"
            "Данные не записывались "
            "в config.json."
        )

        keyboard = [[
            InlineKeyboardButton(
                "◀️ К аккаунтам",
                callback_data='accounts',
            )
        ]]

        await query.message.edit_text(
            text,
            reply_markup=InlineKeyboardMarkup(
                keyboard
            ),
        )

    
    elif query.data == 'logs':
        try:
            with open('logs/bot.log', 'r', encoding='utf-8') as f:
                lines = f.readlines()
                last_lines = lines[-20:] if len(lines) >= 20 else lines
                log_text = ''.join(last_lines)
            text = f" Последние 20 строк:\n\n<pre>{log_text}</pre>"
        except:
            text = "Логов пока нет"
        keyboard = [[InlineKeyboardButton("◀️ Назад", callback_data='main_menu')]]
        reply_markup = InlineKeyboardMarkup(keyboard)
        await query.message.edit_text(text, parse_mode='HTML', reply_markup=reply_markup)
    
    elif query.data == 'pause':
        if not os.path.exists('pause.flag'):
            open('pause.flag', 'w').close()
            text = "⏸️ Бот на паузе"
        else:
            text = "⏸️ Уже на паузе"
        keyboard = [[InlineKeyboardButton("️ Назад", callback_data='main_menu')]]
        reply_markup = InlineKeyboardMarkup(keyboard)
        await query.message.edit_text(text, reply_markup=reply_markup)
    
    elif query.data == 'resume':
        if os.path.exists('pause.flag'):
            os.remove('pause.flag')
            text = "▶️ Бот возобновил работу"
        else:
            text = "▶️ Уже работает"
        keyboard = [[InlineKeyboardButton("◀️ Назад", callback_data='main_menu')]]
        reply_markup = InlineKeyboardMarkup(keyboard)
        await query.message.edit_text(text, reply_markup=reply_markup)
    
    elif query.data == 'restart':
        text = "🔄 Как перезапустить:\n\n1. Остановить: Ctrl+C\n2. Запустить: python3 bot.py"
        keyboard = [[InlineKeyboardButton("◀️ Назад", callback_data='main_menu')]]
        reply_markup = InlineKeyboardMarkup(keyboard)
        await query.message.edit_text(text, reply_markup=reply_markup)

async def message_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_user.id not in ADMIN_IDS:
        return
    
    action = context.user_data.get('action')

    # =====================================================
    # SAFE VK ACCOUNT WIZARD V1
    # =====================================================

    if action == 'account_add_user_id':
        raw_user_id = update.message.text.strip()

        try:
            user_id = int(raw_user_id)
        except (TypeError, ValueError):
            await update.message.reply_text(
                "❌ VK ID должен состоять "
                "только из цифр."
            )
            return

        if user_id <= 0:
            await update.message.reply_text(
                "❌ VK ID должен быть "
                "положительным числом."
            )
            return

        try:
            cfg = load_config_fresh()
            accounts = cfg.get(
                'vk_accounts',
                [],
            )
        except Exception:
            await update.message.reply_text(
                "❌ Не удалось безопасно "
                "прочитать config.json.\n"
                "Добавление остановлено."
            )
            return

        duplicate = any(
            isinstance(account, dict)
            and str(
                account.get('user_id')
            ) == str(user_id)
            for account in accounts
        )

        if duplicate:
            context.user_data.pop(
                'vk_account_draft',
                None,
            )
            context.user_data.pop(
                'action',
                None,
            )

            await update.message.reply_text(
                "❌ Такой VK ID уже есть "
                "в рабочей конфигурации.\n"
                "Черновик удалён."
            )
            return

        draft = context.user_data.setdefault(
            'vk_account_draft',
            {},
        )

        draft['user_id'] = user_id

        context.user_data[
            'action'
        ] = 'account_add_phone'

        await update.message.reply_text(
            "➕ Новый VK-аккаунт — шаг 2/2\n\n"
            f"VK ID: {user_id}\n\n"
            "Теперь отправьте телефон, "
            "который будет использоваться "
            "в объявлении.\n\n"
            "Пароль VK и токен "
            "НЕ отправляйте."
        )
        return

    if action == 'account_add_phone':
        phone = update.message.text.strip()

        if not phone:
            await update.message.reply_text(
                "❌ Телефон не может быть пустым."
            )
            return

        if len(phone) > 40:
            await update.message.reply_text(
                "❌ Слишком длинное значение.\n"
                "Введите только телефон."
            )
            return

        draft = context.user_data.get(
            'vk_account_draft',
        )

        if not isinstance(draft, dict):
            context.user_data.pop(
                'action',
                None,
            )

            await update.message.reply_text(
                "❌ Черновик потерян.\n"
                "Начните добавление заново."
            )
            return

        user_id = draft.get('user_id')

        if user_id is None:
            context.user_data.pop(
                'vk_account_draft',
                None,
            )
            context.user_data.pop(
                'action',
                None,
            )

            await update.message.reply_text(
                "❌ В черновике отсутствует VK ID.\n"
                "Начните добавление заново."
            )
            return

        draft['phone'] = phone

        context.user_data.pop(
            'action',
            None,
        )

        text = (
            "📋 Черновик VK-аккаунта готов\n\n"
            f"🆔 VK ID: {user_id}\n"
            f"📞 Телефон: {phone}\n"
            "⏸️ Статус: НЕ СОХРАНЁН\n"
            "🔐 Авторизация VK: "
            "НЕ ПОДКЛЮЧЕНА\n\n"
            "Черновик находится только "
            "во временной памяти админки.\n"
            "config.json не изменён.\n"
            "VK API не вызывался."
        )

        keyboard = [
            [
                InlineKeyboardButton(
                    "💾 Сохранить отключённым",
                    callback_data='account_add_save',
                )
            ],
            [
                InlineKeyboardButton(
                    "🗑 Удалить черновик",
                    callback_data='account_add_discard',
                ),
                InlineKeyboardButton(
                    "👥 К аккаунтам",
                    callback_data='accounts',
                ),
            ],
        ]

        await update.message.reply_text(
            text,
            reply_markup=InlineKeyboardMarkup(
                keyboard
            ),
        )
        return

    
    if action == 'add_message':
        text = update.message.text
        messages = load_messages()
        messages.append(text)
        save_messages(messages)
        await update.message.reply_text(f"✅ Текст добавлен!\n\nВсего: {len(messages)}")
        context.user_data['action'] = None
    
    elif action and action.startswith('edit_message_'):
        msg_num = int(action.split('_')[-1])
        new_text = update.message.text
        messages = load_messages()
        
        if 1 <= msg_num <= len(messages):
            messages[msg_num - 1] = new_text
            save_messages(messages)
            await update.message.reply_text(f"✅ Текст #{msg_num} обновлён!")
        else:
            await update.message.reply_text("❌ Текст не найден")
        
        context.user_data['action'] = None
    
    elif action == 'set_post_interval':
        try:
            seconds = int(update.message.text)
            settings = load_settings()
            settings['post_interval'] = seconds
            save_settings(settings)
            await update.message.reply_text(f"✅ Пауза: {seconds} сек")
        except:
            await update.message.reply_text("❌ Введите число")
        context.user_data['action'] = None
    
    elif action == 'set_check_interval':
        try:
            hours = int(update.message.text)
            settings = load_settings()
            settings['check_interval'] = hours * 3600
            save_settings(settings)
            await update.message.reply_text(f"✅ Интервал: {hours} ч")
        except:
            await update.message.reply_text("❌ Введите число")
        context.user_data['action'] = None
    
    elif action == 'set_delete_delay':
        try:
            minutes = int(update.message.text)
            settings = load_settings()
            settings['delete_delay'] = minutes
            save_settings(settings)
            await update.message.reply_text(f"✅ Время удаления: {minutes} мин")
        except:
            await update.message.reply_text("❌ Введите число")
        context.user_data['action'] = None

def main():
    print("Telegram админка запущена")
    print(f"Администраторы: {ADMIN_IDS}")
    app = Application.builder().token(BOT_TOKEN).build()
    app.add_handler(CommandHandler('start', start))
    app.add_handler(CommandHandler('cancel', lambda u, c: show_main_menu(u, c)))
    app.add_handler(CallbackQueryHandler(button_handler))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, message_handler))
    app.run_polling()

if __name__ == '__main__':
    main()

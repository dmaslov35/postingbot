def validate_account_for_enable(account):
    """
    Локальная проверка записи аккаунта перед включением.

    VK API НЕ вызывается.
    Токен НЕ выводится и НЕ логируется.

    Возвращает:
        (True, []) — запись готова к ручному включению
        (False, [причины]) — включение запрещено
    """
    errors = []

    if not isinstance(account, dict):
        return False, ['повреждённая запись аккаунта']

    user_id = account.get('user_id')

    if user_id is None or str(user_id).strip() == '':
        errors.append('не указан VK user_id')
    else:
        try:
            parsed_user_id = int(str(user_id).strip())

            if parsed_user_id <= 0:
                errors.append('VK user_id должен быть положительным')
        except (TypeError, ValueError):
            errors.append('VK user_id имеет неверный формат')

    token = account.get('token')

    if not isinstance(token, str) or not token.strip():
        errors.append('нет данных авторизации VK')

    phone = account.get('phone')

    if phone is None or not str(phone).strip():
        errors.append('не указан телефон для объявления')

    return not errors, errors


def account_label(account, index):
    user_id = account.get('user_id')
    enabled = account.get('enabled', True)

    emoji = '🟢' if enabled else '⏸️'

    if user_id:
        return f"{emoji} #{index + 1} · ID {user_id}"

    return f"{emoji} #{index + 1} · без ID"



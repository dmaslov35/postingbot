class WorkerStop(RuntimeError):
    pass


def verify_assigned_vk_identity(page):
    """Fail closed if the active VK profile differs from the assigned account."""
    import os
    import sqlite3

    account_id_raw = os.environ.get("VKBOT_ACCOUNT_ID", "")
    if not account_id_raw.isdecimal() or int(account_id_raw) <= 0:
        raise WorkerStop("VK_IDENTITY_ACCOUNT_NOT_ASSIGNED")

    account_id = int(account_id_raw)

    from vk_account_auth import verified_self_id
    import vk_multi_account as multi

    db_path = getattr(multi, "DB_FILE", None)
    if db_path is None:
        raise WorkerStop("VK_IDENTITY_DATABASE_NOT_CONFIGURED")

    try:
        with sqlite3.connect(f"file:{Path(db_path).resolve()}?mode=ro", uri=True) as con:
            row = con.execute(
                "SELECT vk_user_id FROM account_verified_identity "
                "WHERE account_id=?",
                (account_id,),
            ).fetchone()
    except (sqlite3.Error, OSError, ValueError) as exc:
        raise WorkerStop(
            "VK_IDENTITY_DATABASE_ERROR:" + type(exc).__name__
        ) from None

    if not row or not isinstance(row[0], int) or row[0] <= 0:
        raise WorkerStop("VK_IDENTITY_NOT_REGISTERED")

    actual_vk_id = verified_self_id(page)

    if actual_vk_id is None:
        raise WorkerStop("VK_IDENTITY_SESSION_UNVERIFIED")

    if actual_vk_id != row[0]:
        raise WorkerStop("VK_IDENTITY_MISMATCH")

    log("VK_IDENTITY_MATCH_CONFIRMED")
    return True


def log(msg):
    line = f"[{datetime.now():%Y-%m-%d %H:%M:%S}] {msg}"
    print(line)
    with LOG_FILE.open("a", encoding="utf-8") as f:
        f.write(line + "\n")


def pause(a=MIN_ACTION_PAUSE_SEC, b=MAX_ACTION_PAUSE_SEC):
    time.sleep(random.uniform(a, b))


def generate_dates():
    ds = [datetime.now(__import__("zoneinfo").ZoneInfo("Asia/Krasnoyarsk")) + timedelta(days=i) for i in range(3)]
    if ds[0].month == ds[-1].month:
        return ", ".join(str(x.day) for x in ds) + " " + MONTHS_RU[ds[0].month - 1]
    return (
        f"{ds[0].day} {MONTHS_RU[ds[0].month - 1]}, "
        f"{ds[1].day} {MONTHS_RU[ds[1].month - 1]}, "
        f"{ds[2].day} {MONTHS_RU[ds[2].month - 1]}"
    )


def load_messages():
    """
    Load posting templates from messages.xlsx.

    Expected workbook:
      sheet: first sheet
      column A header: message
      rows 2+: message templates

    Empty rows are ignored.
    """
    if not MESSAGES_FILE.exists():
        raise RuntimeError(
            f"MESSAGES_FILE_NOT_FOUND:{MESSAGES_FILE}"
        )

    wb = load_workbook(
        MESSAGES_FILE,
        read_only=True,
        data_only=True,
    )

    try:
        ws = wb[wb.sheetnames[0]]

        header = ws.cell(1, 1).value

        if str(header).strip().lower() != "message":
            raise RuntimeError(
                f"MESSAGES_BAD_HEADER:{header!r}"
            )

        messages = []

        for row in range(2, ws.max_row + 1):
            value = ws.cell(row, 1).value

            if value is None:
                continue

            text = str(value).strip()

            if not text:
                continue

            messages.append(text)

        if not messages:
            raise RuntimeError("MESSAGES_EMPTY")

        return messages

    finally:
        wb.close()


def build_message():
    messages = load_messages()

    template = random.choice(messages)

    return (
        template
        .replace("{PHONE}", PHONE)
        .replace("{DATES}", generate_dates())
    )



def normalize_vk_url(raw):
    raw = raw.strip()
    if not raw:
        return None
    if "://" not in raw:
        raw = "https://" + raw

    parsed = urlparse(raw)
    host = parsed.netloc.lower().split(":")[0]

    if host in {"vk.com", "www.vk.com", "vk.ru", "www.vk.ru"}:
        host = "vk.ru"

    path = "/" + parsed.path.strip("/")
    if path == "/":
        return None

    return f"https://{host}{path}"


def load_groups():
    if MODE == "TEST":
        return [TEST_GROUP]

    if MODE == "PRODUCTION" and not ENABLE_PRODUCTION:
        raise RuntimeError("PRODUCTION_LOCKED")

    if MODE not in {"SCAN", "PREPARE", "PRODUCTION"}:
        raise RuntimeError(f"UNKNOWN_MODE:{MODE}")

    if not GROUPS_FILE.exists():
        raise RuntimeError(f"Нет файла {GROUPS_FILE}")

    out, seen = [], set()

    for raw in GROUPS_FILE.read_text(encoding="utf-8-sig").splitlines():
        url = normalize_vk_url(raw)
        if not url:
            continue

        key = url.lower()
        if key in seen:
            continue

        seen.add(key)
        out.append(url)

    return out

def load_state():
    if not STATE_FILE.exists():
        return {"groups": {}, "runs": []}
    try:
        d = json.loads(STATE_FILE.read_text(encoding="utf-8"))
        if not isinstance(d, dict):
            raise ValueError
        d.setdefault("groups", {})
        d.setdefault("runs", [])
        return d
    except Exception:
        raise RuntimeError("STATE повреждён. Worker остановлен для защиты от дублей.")


def save_state(state):
    tmp = STATE_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(state, ensure_ascii=False, indent=2), encoding="utf-8")
    tmp.replace(STATE_FILE)


def update_group(state, url, status, **extra):
    old = state["groups"].get(url, {})
    rec = dict(old)
    rec.update(extra)
    rec["status"] = status
    rec["updated_at"] = datetime.now().isoformat(timespec="seconds")
    state["groups"][url] = rec
    save_state(state)
    log(f"STATE {url} -> {status}")


def visible(locator):
    out = []
    try:
        n = locator.count()
    except Exception:
        return out
    for i in range(n):
        try:
            x = locator.nth(i)
            if x.is_visible():
                out.append(x)
        except Exception:
            pass
    return out


def exact(page, text):
    return visible(page.get_by_text(text, exact=True))


def detect_block(page):
    u = page.url.lower()
    if "challenge" in u:
        return "VK_CHALLENGE"
    markers = [
        "Проверяем, что вы не робот",
        "Подтвердите, что вы не робот",
        "Подтвердите вход",
        "Слишком много попыток",
    ]
    for m in markers:
        try:
            if visible(page.get_by_text(m, exact=False)):
                return "VK_VERIFICATION"
        except Exception:
            pass
    return None


def assert_no_block(page):
    b = detect_block(page)
    if b:
        raise WorkerStop(b)


def scan_entries(page):
    """Ищем управляющие элементы по странице без кликов."""
    result = {
        "suggest": None,
        "create": None,
        "subscribe": None,
        "join": None,
        "subscribed": False,
    }

    page.evaluate("window.scrollTo(0,0)")
    pause(.5, .9)

    for step in range(16):
        assert_no_block(page)

        sug = exact(page, "Предложить пост")
        cre = exact(page, "Создать")
        sub = exact(page, "Подписаться")
        joi = exact(page, "Подать заявку")
        yes = exact(page, "Вы подписаны")

        if len(sug) == 1 and result["suggest"] is None:
            result["suggest"] = sug[0]
        if len(cre) == 1 and result["create"] is None:
            result["create"] = cre[0]
        if len(sub) == 1 and result["subscribe"] is None:
            result["subscribe"] = sub[0]
        if len(joi) == 1 and result["join"] is None:
            result["join"] = joi[0]
        if yes:
            result["subscribed"] = True

        # Предложение поста имеет приоритет.
        if result["suggest"] is not None:
            break

        page.evaluate("window.scrollBy(0,300)")
        pause(.65, 1.05)

    return result


def unique_editor(page):
    editors = visible(page.locator('[role="textbox"][contenteditable="true"]'))
    if len(editors) != 1:
        raise RuntimeError(f"EDITOR_NOT_UNIQUE:{len(editors)}")
    return editors[0]


def open_post_editor(page, entry, flow):
    entry.click(timeout=10000)
    pause(1.4, 2.0)
    assert_no_block(page)

    if len(exact(page, "Новый пост")) != 1:
        raise RuntimeError(f"{flow}_NEW_POST_NOT_UNIQUE")

    return unique_editor(page)


def fill_and_next(page, editor, text):
    editor.fill(text)
    if editor.inner_text().strip() != text.strip():
        raise RuntimeError("EDITOR_TEXT_VERIFY_FAILED")
    log("EDITOR TEXT VERIFIED")

    nxt = exact(page, "Далее")
    if len(nxt) != 1:
        raise RuntimeError(f"NEXT_NOT_UNIQUE:{len(nxt)}")

    btn = nxt[0].locator(
        "xpath=ancestor-or-self::*[self::button or @role='button'][1]"
    )
    if btn.count() != 1:
        raise RuntimeError("NEXT_BUTTON_NOT_UNIQUE")

    btn.click(timeout=10000)
    pause(1.8, 2.5)
    assert_no_block(page)
    log("NEXT CLICKED")


def dialog_buttons(page, names):
    found = []
    for dialog in visible(page.locator('[role="dialog"]')):
        for name in names:
            found.extend(
                visible(dialog.get_by_role("button", name=name, exact=True))
            )
    return found



def ensure_author_signature(page):
    """Включает и проверяет подпись автора перед отправкой."""
    selector = '[data-testid="posting_settings_sign_switch_input"]'
    switch = page.locator(selector)

    if switch.count() != 1:
        raise RuntimeError("AUTHOR_SIGNATURE_SWITCH_NOT_UNIQUE")

    if switch.get_attribute("type") != "checkbox":
        raise RuntimeError("AUTHOR_SIGNATURE_WRONG_ELEMENT")

    state = switch.get_attribute("aria-checked")

    if state == "false":
        switch.locator("xpath=ancestor::label[1]").click(timeout=5000)
        page.wait_for_timeout(400)
    elif state != "true":
        raise RuntimeError("AUTHOR_SIGNATURE_UNKNOWN_STATE")

    if switch.get_attribute("aria-checked") != "true":
        raise RuntimeError("AUTHOR_SIGNATURE_NOT_ENABLED")

    log("AUTHOR SIGNATURE ENABLED AND VERIFIED")



def final_button_suggest(page):

def resolve_token_for_post(
    post: Dict[str, Any],
    accounts: List[Dict[str, Any]],
) -> Optional[str]:
    """
    Задачи удаления используют только account_user_id.

    Legacy account_token намеренно больше не используется:
    старые записи должны находиться вне активной очереди.
    """
    account_user_id = post.get("account_user_id")

    if account_user_id is None:
        return None

    for account in accounts:
        if str(account.get("user_id")) == str(account_user_id):
            return account.get("token")

    return None


def cleanup_deleted_posts(posts: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    cutoff = datetime.now() - timedelta(hours=DELETED_POST_RETENTION_HOURS)
    result = []

    for post in posts:
        if post.get("status") != "deleted":
            result.append(post)
            continue

        deleted_at_raw = post.get("deleted_at")

        if not deleted_at_raw:
            continue

        try:
            deleted_at = datetime.fromisoformat(deleted_at_raw)
        except (TypeError, ValueError):
            continue

        if deleted_at >= cutoff:
            result.append(post)

    return result


def check_and_delete_old_posts(
    accounts: Optional[List[Dict[str, Any]]] = None,
) -> None:
    """
    Безопасная обработка очереди удаления.

    - только account_user_id;
    - максимум 3 задачи за проход;
    - Error 9 включает глобальный persistent backoff на 15 минут;
    - во время backoff VK API для удаления вообще не вызывается.
    """
    logger.info("Проверка очереди удаления постов...")

    state = load_state()
    now = datetime.now()

    backoff_raw = state.get("delete_backoff_until")

    if backoff_raw:
        try:
            backoff_until = datetime.fromisoformat(backoff_raw)
        except (TypeError, ValueError):
            state.pop("delete_backoff_until", None)
            save_state(state)
        else:
            if now < backoff_until:
                remaining = max(
                    1,
                    int((backoff_until - now).total_seconds()),
                )
                logger.info(
                    "Удаление находится в global backoff ещё %s сек. "
                    "VK API не вызывается.",
                    remaining,
                )
                return

            state.pop("delete_backoff_until", None)
            save_state(state)

    if accounts is None:
        config = load_config()
        accounts = [
            acc
            for acc in config["vk_accounts"]
            if is_account_runtime_ready(acc)
        ]

    posts = load_published_posts()

    if not posts:
        logger.info("Очередь удаления пуста.")
        return

    settings = load_settings()
    delete_delay = timedelta(minutes=settings["delete_delay"])

    max_tasks_per_run = 3
    request_pause_seconds = 2.0
    flood_backoff_seconds = 15 * 60

    deleted_count = 0
    attempted_count = 0
    changed = False
    flood_stopped = False

    for post in posts:
        if attempted_count >= max_tasks_per_run:
            logger.info(
                "Достигнут лимит обработки удаления за проход: %s задач.",
                max_tasks_per_run,
            )
            break

        if post.get("status") == "deleted":
            continue

        created_at_raw = (
            post.get("created_at")
            or post.get("published_on_wall_at")
        )

        try:
            created_at = datetime.fromisoformat(created_at_raw)
        except (TypeError, ValueError):
            logger.warning(
                "У поста %s_%s нет корректного created_at. Пропускаем.",
                post.get("owner_id"),
                post.get("post_id"),
            )
            continue

        if now - created_at < delete_delay:
            continue

        token = resolve_token_for_post(post, accounts)

        # Final fresh-account revalidation for deletion.
        # The account list passed to this function may be stale.
        # Use account_user_id as the stable identity and obtain
        # the CURRENT token immediately before VK construction.
        fresh_delete_account = get_fresh_runtime_account(
            post.get("account_user_id")
        )

        if fresh_delete_account is None:
            logger.warning(
                "DELETE DEFERRED | Post %s_%s | "
                "account_user_id %s отсутствует, выключен "
                "или не готов к VK API.",
                post.get("owner_id"),
                post.get("post_id"),
                post.get("account_user_id"),
            )
            remaining.append(post)
            continue

        token = fresh_delete_account["token"]

        if not token:
            logger.warning(
                "Для задачи %s_%s не найден активный account_user_id/token. "
                "VK API не вызывается.",
                post.get("owner_id"),
                post.get("post_id"),
            )
            continue

        attempted_count += 1

        try:
            vk = create_vk_api(token)

            status = check_post_status(
                vk,
                int(post["owner_id"]),
                int(post["post_id"]),
            )

            if status == "not_found":
                post["status"] = "deleted"
                post["deleted_at"] = datetime.now().isoformat(
                    timespec="seconds"
                )
                post["delete_result"] = "already_missing"
                changed = True
                deleted_count += 1

            elif status == "published":
                vk_call_with_retry(
                    vk.wall.delete,
                    owner_id=int(post["owner_id"]),
                    post_id=int(post["post_id"]),
                )

                post["status"] = "deleted"
                post["deleted_at"] = datetime.now().isoformat(
                    timespec="seconds"
                )
                post["delete_result"] = "deleted_by_bot"
                changed = True
                deleted_count += 1

                logger.info(
                    "Удалён пост %s из группы %s",
                    post["post_id"],
                    post["owner_id"],
                )

            elif status == "flood":
                flood_stopped = True

                backoff_until = datetime.now() + timedelta(
                    seconds=flood_backoff_seconds
                )

                state = load_state()
                state["delete_backoff_until"] = backoff_until.isoformat(
                    timespec="seconds"
                )
                save_state(state)

                logger.warning(
                    "VK Flood control при удалении. "
                    "Global backoff установлен до %s.",
                    backoff_until.isoformat(timespec="seconds"),
                )
                break

            time.sleep(request_pause_seconds)

        except vk_api.exceptions.ApiError as e:
            logger.warning(
                "Не удалось удалить %s_%s: VK Error %s: %s",
                post.get("owner_id"),
                post.get("post_id"),
                e.code,
                e,
            )

            if e.code == 9:
                flood_stopped = True

                backoff_until = datetime.now() + timedelta(
                    seconds=flood_backoff_seconds
                )

                state = load_state()
                state["delete_backoff_until"] = backoff_until.isoformat(
                    timespec="seconds"
                )
                save_state(state)

                logger.warning(
                    "VK Error 9 при удалении. "
                    "Global backoff установлен до %s.",
                    backoff_until.isoformat(timespec="seconds"),
                )
                break

            time.sleep(request_pause_seconds)

        except Exception as e:
            logger.exception(
                "Ошибка удаления %s_%s: %s",
                post.get("owner_id"),
                post.get("post_id"),
                e,
            )
            time.sleep(request_pause_seconds)

    cleaned = cleanup_deleted_posts(posts)

    if changed or len(cleaned) != len(posts):
        save_published_posts(cleaned)

    logger.info(
        "Проверка удаления завершена. "
        "Попыток: %s. Удалено/закрыто: %s. "
        "В очереди: %s. Flood-stop: %s",
        attempted_count,
        deleted_count,
        len(cleaned),
        flood_stopped,
    )



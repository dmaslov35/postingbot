def save_new_post(
    owner_id: int,
    post_id: int,
    account: Dict[str, Any],
) -> None:
    posts = load_published_posts()

    posts.append(
        {
            "owner_id": owner_id,
            "post_id": post_id,
            "created_at": datetime.now().isoformat(timespec="seconds"),
            "status": "pending",
            "account_user_id": account.get("user_id"),
        }
    )

    save_published_posts(posts)


def classify_api_error(code: int) -> str:
    if code in AUTH_ERROR_CODES:
        return "auth"
    if code == 214:
        return "group_limit"
    if code in ACCOUNT_COOLDOWN_ERROR_CODES:
        return "temporary_account"
    return "api"


def handle_vk_api_error(
    e: vk_api.exceptions.ApiError,
    account: Dict[str, Any],
    account_index: int,
    group_id: int,
    state: Dict[str, Any],
) -> None:
    error_type = classify_api_error(e.code)
    account_id = account.get("user_id", account_index)

    logger.warning(
        "VK Error %s | Account %s | Group %s | %s",
        e.code,
        account_id,
        group_id,
        e,
    )

    add_error_stat(
        account_id=account_id,
        group_id=group_id,
        error_type=error_type,
        error_text=str(e),
        error_code=e.code,
    )

    if error_type == "auth":
        set_account_status(account_id, f"AUTH_ERROR_{e.code}")
        # Ошибка авторизации редко проходит сама быстро.
        set_account_cooldown(
            state,
            account,
            account_index,
            6 * 60 * 60,
        )

    elif error_type == "temporary_account":
        set_account_status(account_id, f"TEMP_ERROR_{e.code}")
        set_account_cooldown(
            state,
            account,
            account_index,
            DEFAULT_ACCOUNT_COOLDOWN_SECONDS,
        )

    elif error_type == "group_limit":
        # Error 214 относится к конкретной публикации/стене,
        # поэтому не помечаем весь аккаунт как нерабочий.
        set_group_status(group_id, "LIMIT_214")

    else:
        set_group_status(group_id, f"VK_ERROR_{e.code}")



def get_fresh_runtime_account(
    user_id: Any,
) -> Optional[Dict[str, Any]]:
    """
    Reload config.json and return the current runtime-ready
    account matching user_id.

    Fail closed. No VK API calls.
    """
    if isinstance(user_id, bool):
        return None

    try:
        normalized_user_id = int(
            str(user_id).strip()
        )
    except (TypeError, ValueError):
        return None

    if normalized_user_id <= 0:
        return None

    try:
        fresh_config = load_config()
    except Exception:
        logger.exception(
            "Не удалось перечитать config.json "
            "перед VK-действием | Account %s",
            normalized_user_id,
        )
        return None

    accounts = fresh_config.get(
        "vk_accounts",
        [],
    )

    if not isinstance(accounts, list):
        return None

    matches = []

    for candidate in accounts:
        if not isinstance(candidate, dict):
            continue

        candidate_id = candidate.get("user_id")

        if isinstance(candidate_id, bool):
            continue

        try:
            candidate_id = int(
                str(candidate_id).strip()
            )
        except (TypeError, ValueError):
            continue

        if candidate_id == normalized_user_id:
            matches.append(candidate)

    # Duplicate UID must fail closed.
    if len(matches) != 1:
        return None

    fresh_account = matches[0]

    if not is_account_runtime_ready(
        fresh_account
    ):
        return None

    return fresh_account


def publish_one_post(
    account: Dict[str, Any],
    account_index: int,
    group_id: int,
    messages: List[str],
    state: Dict[str, Any],
) -> bool:
    account_id = account.get("user_id", account_index)

    # Final fail-closed revalidation immediately before
    # constructing the VK API object. The account selected
    # by main() may already be stale.
    fresh_account = get_fresh_runtime_account(account_id)

    if fresh_account is None:
        logger.warning(
            "PUBLISH CANCELLED | Account %s "
            "больше не существует, выключен "
            "или не готов к VK API.",
            account_id,
        )
        return False

    # From this point use ONLY the fresh snapshot.
    account = fresh_account
    account_id = account["user_id"]

    try:
        vk = create_vk_api(account["token"])

        random_message = random.choice(messages)
        account_phone = account.get("phone", "Не указан")
        current_dates = generate_dates()

        final_message = (
            random_message
            .replace("{PHONE}", str(account_phone))
            .replace("{DATES}", current_dates)
        )

        response = vk_call_with_retry(
            vk.wall.post,
            owner_id=group_id,
            message=final_message,
        )

        post_id = int(response["post_id"])

        save_new_post(
            owner_id=group_id,
            post_id=post_id,
            account=account,
        )

        increment_success(account_id, group_id)

        logger.info(
            "POSTED | Account %s | Group %s | Post ID %s | Phone %s | Dates %s",
            account_id,
            group_id,
            post_id,
            account_phone,
            current_dates,
        )

        return True

    except KeyError as e:
        logger.error("В аккаунте %s отсутствует поле %s", account_id, e)
        set_account_status(account_id, "CONFIG_ERROR")
        return False

    except vk_api.exceptions.ApiError as e:
        handle_vk_api_error(
            e=e,
            account=account,
            account_index=account_index,
            group_id=group_id,
            state=state,
        )
        return False

    except Exception as e:
        logger.exception(
            "Системная/сетевая ошибка | Account %s | Group %s: %s",
            account_id,
            group_id,
            e,
        )

        add_error_stat(
            account_id=account_id,
            group_id=group_id,
            error_type="system",
            error_text=str(e),
        )

        set_account_cooldown(
            state,
            account,
            account_index,
            5 * 60,
        )

        return False



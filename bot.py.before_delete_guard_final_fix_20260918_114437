def main() -> None:
    logger.info("=" * 70)
    logger.info("Запуск VK Bot v2")
    logger.info("=" * 70)

    config = load_config()

    accounts = [
        acc
        for acc in config["vk_accounts"]
        if is_account_runtime_ready(acc)
    ]

    excel_file = config["settings"]["excel_file"]
    groups = load_groups(excel_file)
    messages = load_messages("messages.xlsx")

    if not accounts:
        logger.warning(
            "Нет включённых VK-аккаунтов. "
            "Запуск в режиме ожидания аккаунтов."
        )

    if not groups:
        logger.error("Список групп пуст.")
        return

    if not messages:
        logger.error("Список сообщений пуст.")
        return

    state = load_state()

    logger.info(
        "Готово к работе. Аккаунтов: %s | Групп: %s | Текстов: %s",
        len(accounts),
        len(groups),
        len(messages),
    )

    # Проверка очереди сразу после рестарта.
    try:
        check_and_delete_old_posts(accounts)
    except Exception:
        logger.exception("Ошибка стартовой проверки удаления")
    finally:
        # Удаление может изменить bot_state.json.
        # Перечитываем state, чтобы main не затёр свежие данные.
        state = load_state()

    # Стартовая проверка уже выполнена выше.
    # Следующую проверку планируем через заданный период,
    # чтобы не запускать очередь удаления второй раз подряд.
    startup_settings = load_settings()
    delete_check_period = min(startup_settings["check_interval"], 60)
    next_delete_check = time.monotonic() + delete_check_period

    while True:
        try:
            # Настройки перечитываются в каждом цикле,
            # поэтому изменения Telegram-админки применяются без рестарта.
            settings = load_settings()

            # Удаление работает независимо от публикаций и продолжает
            # выполняться даже когда публикации поставлены на паузу.
            if time.monotonic() >= next_delete_check:
                try:
                    check_and_delete_old_posts(accounts)
                    # Удаление работает со свежим bot_state.json.
                    # Синхронизируем main перед будущим save_state().
                    state = load_state()
                except Exception:
                    logger.exception("Ошибка плановой проверки удаления")

                # Для точного delete_delay очередь удаления проверяем не реже
                # одного раза в минуту. Если check_interval меньше минуты —
                # используем указанное пользователем значение.
                delete_check_period = min(settings["check_interval"], 60)
                next_delete_check = time.monotonic() + delete_check_period

            if check_pause():
                time.sleep(1)
                continue

            # Горячая перезагрузка VK-аккаунтов.
            # Telegram-админка сможет менять config.json без рестарта bot.py.
            try:
                fresh_config = load_config()
                accounts = [
                    acc
                    for acc in fresh_config["vk_accounts"]
                    if is_account_runtime_ready(acc)
                ]
            except Exception:
                logger.exception(
                    "Не удалось перечитать VK-аккаунты из config.json. "
                    "Публикация пропущена."
                )
                smart_sleep(30)
                continue

            if not accounts:
                logger.info(
                    "Режим ожидания: включённых VK-аккаунтов нет. "
                    "VK API не вызывается."
                )
                smart_sleep(30)
                continue

            available = get_next_available_account(accounts, state)

            if available is None:
                logger.warning(
                    "Все включённые VK-аккаунты находятся в cooldown. "
                    "VK API не вызывается. "
                    "Повторная проверка через 60 секунд."
                )
                smart_sleep(60)
                continue

            account_index, account = available

            group_index = int(state.get("group_index", 0)) % len(groups)
            group_id = groups[group_index]

            logger.info("-" * 70)
            logger.info(
                "Account %s/%s: %s | Group %s/%s: %s",
                account_index + 1,
                len(accounts),
                account.get("user_id", account_index),
                group_index + 1,
                len(groups),
                group_id,
            )

            publish_one_post(
                account=account,
                account_index=account_index,
                group_id=group_id,
                messages=messages,
                state=state,
            )

            # Всегда двигаем очередь дальше, даже если конкретная публикация
            # завершилась ошибкой. Так одна проблемная группа не блокирует цикл.
            state["account_index"] = (account_index + 1) % len(accounts)
            state["group_index"] = (group_index + 1) % len(groups)
            save_state(state)

            smart_sleep(load_settings()["post_interval"])

        except KeyboardInterrupt:
            logger.info("Получен KeyboardInterrupt. Завершение работы.")
            break

        except Exception as e:
            logger.exception("Критическая ошибка основного цикла: %s", e)
            time.sleep(30)


if __name__ == "__main__":
    main()

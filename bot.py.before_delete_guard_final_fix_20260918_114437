def load_published_posts() -> List[Dict[str, Any]]:
    data = load_json_file(POSTS_FILE, [])
    return data if isinstance(data, list) else []


def save_published_posts(posts: List[Dict[str, Any]]) -> None:
    atomic_write_json(POSTS_FILE, posts)


def load_stats() -> Dict[str, Any]:
    data = load_json_file(
        STATS_FILE,
        {
            "success": 0,
            "errors": [],
            "accounts_status": {},
            "groups_status": {},
        },
    )

    if not isinstance(data, dict):
        data = {}

    data.setdefault("success", 0)
    data.setdefault("errors", [])
    data.setdefault("accounts_status", {})
    data.setdefault("groups_status", {})

    return data


def save_stats(stats: Dict[str, Any]) -> None:
    atomic_write_json(STATS_FILE, stats)


def load_state() -> Dict[str, Any]:
    data = load_json_file(
        STATE_FILE,
        {
            "account_index": 0,
            "group_index": 0,
            "account_cooldowns": {},
        },
    )

    if not isinstance(data, dict):
        data = {}

    data.setdefault("account_index", 0)
    data.setdefault("group_index", 0)
    data.setdefault("account_cooldowns", {})

    return data


def save_state(state: Dict[str, Any]) -> None:
    atomic_write_json(STATE_FILE, state)


def add_error_stat(
    account_id: Any,
    group_id: Optional[int],
    error_type: str,
    error_text: str,
    error_code: Optional[int] = None,
) -> None:
    stats = load_stats()

    stats["errors"].append(
        {
            "time": datetime.now().isoformat(timespec="seconds"),
            "group": group_id,
            "account": account_id,
            "type": error_type,
            "code": error_code,
            "error": error_text,
        }
    )

    stats["errors"] = stats["errors"][-200:]
    save_stats(stats)


def set_account_status(account_id: Any, status: str) -> None:
    stats = load_stats()
    stats["accounts_status"][str(account_id)] = {
        "status": status,
        "updated_at": datetime.now().isoformat(timespec="seconds"),
    }
    save_stats(stats)


def set_group_status(group_id: int, status: str) -> None:
    stats = load_stats()
    stats["groups_status"][str(group_id)] = {
        "status": status,
        "updated_at": datetime.now().isoformat(timespec="seconds"),
    }
    save_stats(stats)


def increment_success(account_id: Any, group_id: int) -> None:
    stats = load_stats()
    stats["success"] = int(stats.get("success", 0)) + 1

    stats["accounts_status"][str(account_id)] = {
        "status": "OK",
        "updated_at": datetime.now().isoformat(timespec="seconds"),
    }

    stats["groups_status"][str(group_id)] = {
        "status": "OK",
        "updated_at": datetime.now().isoformat(timespec="seconds"),
    }

    save_stats(stats)



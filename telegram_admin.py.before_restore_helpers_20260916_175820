def load_settings():
    try:
        with open('settings.json', 'r', encoding='utf-8') as f:
            return json.load(f)
    except:
        return {'post_interval': 30, 'check_interval': 7200, 'delete_delay': 10}

def save_settings(settings):
    with open('settings.json', 'w', encoding='utf-8') as f:
        json.dump(settings, f, ensure_ascii=False, indent=2)

def load_stats():
    try:
        with open('bot_stats.json', 'r', encoding='utf-8') as f:
            return json.load(f)
    except:
        return {'success': 0, 'errors': [], 'accounts_status': {}}

def load_groups():
    try:
        from openpyxl import load_workbook
        wb = load_workbook('chats.xlsx')
        sheet = wb.active
        groups = []
        for row in sheet.iter_rows(min_row=2, values_only=True):
            if row[0]:
                groups.append(int(row[0]))
        return groups
    except:
        return []

def load_messages():
    try:
        from openpyxl import load_workbook
        wb = load_workbook('messages.xlsx')
        sheet = wb.active
        messages = []
        for row in sheet.iter_rows(min_row=2, values_only=True):
            if row[0]:
                messages.append(str(row[0]))
        return messages
    except:
        return []

def save_messages(messages):
    from openpyxl import Workbook
    wb = Workbook()
    ws = wb.active
    ws.title = 'Messages'
    ws.append(['message'])
    for msg in messages:
        ws.append([msg])
    wb.save('messages.xlsx')


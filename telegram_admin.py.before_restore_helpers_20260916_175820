def _normalize_vk_user_id(user_id):
    try:
        value = int(user_id)
    except (TypeError, ValueError):
        return None

    if value <= 0:
        return None

    return value


def _find_account_index_by_user_id(accounts, user_id):
    target = _normalize_vk_user_id(user_id)

    if target is None:
        return None

    if not isinstance(accounts, list):
        return None

    for index, account in enumerate(accounts):
        if not isinstance(account, dict):
            continue

        current = _normalize_vk_user_id(
            account.get("user_id")
        )

        if current == target:
            return index

    return None


def tx_add_vk_account_disabled(user_id, phone):
    normalized_id = _normalize_vk_user_id(user_id)

    if normalized_id is None:
        return {
            "status": "bad_user_id",
        }

    if not isinstance(phone, str):
        return {
            "status": "bad_phone",
        }

    normalized_phone = phone.strip()

    if (
        not normalized_phone
        or len(normalized_phone) > 40
    ):
        return {
            "status": "bad_phone",
        }

    def mutator(cfg):
        accounts = cfg.get("vk_accounts")

        if not isinstance(accounts, list):
            raise ValueError(
                "vk_accounts is not a list"
            )

        index = _find_account_index_by_user_id(
            accounts,
            normalized_id,
        )

        if index is not None:
            return False, {
                "status": "duplicate",
                "user_id": normalized_id,
            }

        accounts.append({
            "user_id": normalized_id,
            "phone": normalized_phone,
            "token": "",
            "enabled": False,
        })

        return True, {
            "status": "saved",
            "user_id": normalized_id,
        }

    return mutate_config_locked(mutator)


def tx_disable_vk_account(user_id):
    normalized_id = _normalize_vk_user_id(user_id)

    if normalized_id is None:
        return {
            "status": "bad_user_id",
        }

    def mutator(cfg):
        accounts = cfg.get("vk_accounts")

        if not isinstance(accounts, list):
            raise ValueError(
                "vk_accounts is not a list"
            )

        index = _find_account_index_by_user_id(
            accounts,
            normalized_id,
        )

        if index is None:
            return False, {
                "status": "not_found",
            }

        if accounts[index].get("enabled") is False:
            return False, {
                "status": "disabled",
                "user_id": normalized_id,
            }

        accounts[index]["enabled"] = False

        return True, {
            "status": "disabled",
            "user_id": normalized_id,
        }

    return mutate_config_locked(mutator)


def tx_set_vk_account_enabled(user_id, enabled):
    normalized_id = _normalize_vk_user_id(user_id)

    if normalized_id is None:
        return {
            "status": "bad_user_id",
        }

    desired = bool(enabled)

    def mutator(cfg):
        accounts = cfg.get("vk_accounts")

        if not isinstance(accounts, list):
            raise ValueError(
                "vk_accounts is not a list"
            )

        index = _find_account_index_by_user_id(
            accounts,
            normalized_id,
        )

        if index is None:
            return False, {
                "status": "not_found",
            }

        account = accounts[index]

        if desired:
            ready, errors = (
                validate_account_for_enable(
                    account
                )
            )

            if not ready:
                changed = (
                    account.get("enabled")
                    is not False
                )

                account["enabled"] = False

                return changed, {
                    "status": "not_ready",
                    "user_id": normalized_id,
                    "errors": list(errors),
                }

        if account.get("enabled") is desired:
            return False, {
                "status": (
                    "enabled"
                    if desired
                    else "disabled"
                ),
                "user_id": normalized_id,
            }

        account["enabled"] = desired

        return True, {
            "status": (
                "enabled"
                if desired
                else "disabled"
            ),
            "user_id": normalized_id,
        }

    return mutate_config_locked(mutator)


def tx_delete_vk_account(user_id):
    normalized_id = _normalize_vk_user_id(user_id)

    if normalized_id is None:
        return {
            "status": "bad_user_id",
        }

    def mutator(cfg):
        accounts = cfg.get("vk_accounts")

        if not isinstance(accounts, list):
            raise ValueError(
                "vk_accounts is not a list"
            )

        index = _find_account_index_by_user_id(
            accounts,
            normalized_id,
        )

        if index is None:
            return False, {
                "status": "not_found",
            }

        pending_count = (
            get_pending_posts_for_account(
                normalized_id
            )
        )

        if pending_count == -1:
            return False, {
                "status": "queue_error",
                "user_id": normalized_id,
            }

        if pending_count > 0:
            changed = (
                accounts[index].get("enabled")
                is not False
            )

            accounts[index]["enabled"] = False

            return changed, {
                "status": "pending_posts",
                "user_id": normalized_id,
                "pending_count": pending_count,
            }

        accounts.pop(index)

        return True, {
            "status": "deleted",
            "user_id": normalized_id,
        }

    return mutate_config_locked(mutator)



async def message_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_user.id not in ADMIN_IDS:
        return
    
    action = context.user_data.get('action')

    # =====================================================
    # SAFE VK ACCOUNT WIZARD V1
    # =====================================================

    if action == 'account_add_user_id':
        raw_user_id = update.message.text.strip()

        try:
            user_id = int(raw_user_id)
        except (TypeError, ValueError):
            await update.message.reply_text(
                "❌ VK ID должен состоять "
                "только из цифр."
            )
            return

        if user_id <= 0:
            await update.message.reply_text(
                "❌ VK ID должен быть "
                "положительным числом."
            )
            return

        try:
            cfg = load_config_fresh()
            accounts = cfg.get(
                'vk_accounts',
                [],
            )
        except Exception:
            await update.message.reply_text(
                "❌ Не удалось безопасно "
                "прочитать config.json.\n"
                "Добавление остановлено."
            )
            return

        duplicate = any(
            isinstance(account, dict)
            and str(
                account.get('user_id')
            ) == str(user_id)
            for account in accounts
        )

        if duplicate:
            context.user_data.pop(
                'vk_account_draft',
                None,
            )
            context.user_data.pop(
                'action',
                None,
            )

            await update.message.reply_text(
                "❌ Такой VK ID уже есть "
                "в рабочей конфигурации.\n"
                "Черновик удалён."
            )
            return

        draft = context.user_data.setdefault(
            'vk_account_draft',
            {},
        )

        draft['user_id'] = user_id

        context.user_data[
            'action'
        ] = 'account_add_phone'

        await update.message.reply_text(
            "➕ Новый VK-аккаунт — шаг 2/2\n\n"
            f"VK ID: {user_id}\n\n"
            "Теперь отправьте телефон, "
            "который будет использоваться "
            "в объявлении.\n\n"
            "Пароль VK и токен "
            "НЕ отправляйте."
        )
        return

    if action == 'account_add_phone':
        phone = update.message.text.strip()

        if not phone:
            await update.message.reply_text(
                "❌ Телефон не может быть пустым."
            )
            return

        if len(phone) > 40:
            await update.message.reply_text(
                "❌ Слишком длинное значение.\n"
                "Введите только телефон."
            )
            return

        draft = context.user_data.get(
            'vk_account_draft',
        )

        if not isinstance(draft, dict):
            context.user_data.pop(
                'action',
                None,
            )

            await update.message.reply_text(
                "❌ Черновик потерян.\n"
                "Начните добавление заново."
            )
            return

        user_id = draft.get('user_id')

        if user_id is None:
            context.user_data.pop(
                'vk_account_draft',
                None,
            )
            context.user_data.pop(
                'action',
                None,
            )

            await update.message.reply_text(
                "❌ В черновике отсутствует VK ID.\n"
                "Начните добавление заново."
            )
            return

        draft['phone'] = phone

        context.user_data.pop(
            'action',
            None,
        )

        text = (
            "📋 Черновик VK-аккаунта готов\n\n"
            f"🆔 VK ID: {user_id}\n"
            f"📞 Телефон: {phone}\n"
            "⏸️ Статус: НЕ СОХРАНЁН\n"
            "🔐 Авторизация VK: "
            "НЕ ПОДКЛЮЧЕНА\n\n"
            "Черновик находится только "
            "во временной памяти админки.\n"
            "config.json не изменён.\n"
            "VK API не вызывался."
        )

        keyboard = [
            [
                InlineKeyboardButton(
                    "💾 Сохранить отключённым",
                    callback_data='account_add_save',
                )
            ],
            [
                InlineKeyboardButton(
                    "🗑 Удалить черновик",
                    callback_data='account_add_discard',
                ),
                InlineKeyboardButton(
                    "👥 К аккаунтам",
                    callback_data='accounts',
                ),
            ],
        ]

        await update.message.reply_text(
            text,
            reply_markup=InlineKeyboardMarkup(
                keyboard
            ),
        )
        return

    
    if action == 'add_message':
        text = update.message.text
        messages = load_messages()
        messages.append(text)
        save_messages(messages)
        await update.message.reply_text(f"✅ Текст добавлен!\n\nВсего: {len(messages)}")
        context.user_data['action'] = None
    
    elif action and action.startswith('edit_message_'):
        msg_num = int(action.split('_')[-1])
        new_text = update.message.text
        messages = load_messages()
        
        if 1 <= msg_num <= len(messages):
            messages[msg_num - 1] = new_text
            save_messages(messages)
            await update.message.reply_text(f"✅ Текст #{msg_num} обновлён!")
        else:
            await update.message.reply_text("❌ Текст не найден")
        
        context.user_data['action'] = None
    
    elif action == 'set_post_interval':
        try:
            seconds = int(update.message.text)
            settings = load_settings()
            settings['post_interval'] = seconds
            save_settings(settings)
            await update.message.reply_text(f"✅ Пауза: {seconds} сек")
        except:
            await update.message.reply_text("❌ Введите число")
        context.user_data['action'] = None
    
    elif action == 'set_check_interval':
        try:
            hours = int(update.message.text)
            settings = load_settings()
            settings['check_interval'] = hours * 3600
            save_settings(settings)
            await update.message.reply_text(f"✅ Интервал: {hours} ч")
        except:
            await update.message.reply_text("❌ Введите число")
        context.user_data['action'] = None
    
    elif action == 'set_delete_delay':
        try:
            minutes = int(update.message.text)
            settings = load_settings()
            settings['delete_delay'] = minutes
            save_settings(settings)
            await update.message.reply_text(f"✅ Время удаления: {minutes} мин")
        except:
            await update.message.reply_text("❌ Введите число")
        context.user_data['action'] = None

def main():
    print("Telegram админка запущена")
    print(f"Администраторы: {ADMIN_IDS}")
    app = Application.builder().token(BOT_TOKEN).build()
    app.add_handler(CommandHandler('start', start))
    app.add_handler(CommandHandler('cancel', lambda u, c: show_main_menu(u, c)))
    app.add_handler(CallbackQueryHandler(button_handler))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, message_handler))
    app.run_polling()

if __name__ == '__main__':
    main()

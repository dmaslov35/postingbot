def create_vk_api(token: str):
    session = vk_api.VkApi(token=token, api_version="5.199")
    return session.get_api()


def vk_call_with_retry(func, *args, **kwargs):
    """Повторяет только системные/сетевые ошибки. ApiError отдаёт вызывающему коду."""
    last_error = None

    for attempt in range(1, NETWORK_RETRIES + 1):
        try:
            return func(*args, **kwargs)
        except vk_api.exceptions.ApiError:
            raise
        except Exception as e:
            last_error = e

            if attempt >= NETWORK_RETRIES:
                raise

            delay = min(2 ** attempt, 10)
            logger.warning(
                "Сетевая/системная ошибка VK. Попытка %s/%s: %s. Повтор через %s сек.",
                attempt,
                NETWORK_RETRIES,
                e,
                delay,
            )
            time.sleep(delay)

    raise last_error


def check_post_status(vk, owner_id: int, post_id: int) -> str:
    try:
        response = vk_call_with_retry(
            vk.wall.getById,
            posts=f"{owner_id}_{post_id}",
        )

        if response:
            return "published"

        return "not_found"

    except vk_api.exceptions.ApiError as e:
        logger.warning(
            "VK API при проверке поста %s_%s: Error %s: %s",
            owner_id,
            post_id,
            e.code,
            e,
        )

        if e.code == 9:
            return "flood"

        return "error"

    except Exception as e:
        logger.warning(
            "Ошибка проверки поста %s_%s: %s",
            owner_id,
            post_id,
            e,
        )
        return "error"



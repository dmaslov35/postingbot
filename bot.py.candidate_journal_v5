def resolve_token_for_post(
    post: Dict[str, Any],
    accounts: List[Dict[str, Any]],
) -> Optional[str]:
    """
    Задачи удаления используют только account_user_id.

    Legacy account_token намеренно больше не используется:
    старые записи должны находиться вне активной очереди.
    """
    account_user_id = post.get("account_user_id")

    if account_user_id is None:
        return None

    for account in accounts:
        if str(account.get("user_id")) == str(account_user_id):
            return account.get("token")

    return None


def cleanup_deleted_posts(posts: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    cutoff = datetime.now() - timedelta(hours=DELETED_POST_RETENTION_HOURS)
    result = []

    for post in posts:
        if post.get("status") != "deleted":
            result.append(post)
            continue

        deleted_at_raw = post.get("deleted_at")

        if not deleted_at_raw:
            continue

        try:
            deleted_at = datetime.fromisoformat(deleted_at_raw)
        except (TypeError, ValueError):
            continue

        if deleted_at >= cutoff:
            result.append(post)

    return result


def check_and_delete_old_posts(
    accounts: Optional[List[Dict[str, Any]]] = None,
) -> None:
    """
    Безопасная обработка очереди удаления.

    Lock discipline:
    - short POSTS SH snapshot, then release it;
    - never acquire ACCOUNT while a POSTS lock is held;
    - VK work runs under ACCOUNT SH;
    - successful remote result is committed under POSTS EX
      while the same ACCOUNT SH is still held;
    - commit reloads the queue and conditionally updates only
      the exact post identity;
    - cleanup uses a standalone POSTS EX section.

    - только account_user_id;
    - максимум 3 задачи за проход;
    - Error 9 включает глобальный persistent backoff на 15 минут;
    - во время backoff VK API для удаления вообще не вызывается.
    """
    logger.info("Проверка очереди удаления постов...")

    state = load_state()
    now = datetime.now()

    backoff_raw = state.get("delete_backoff_until")

    if backoff_raw:
        try:
            backoff_until = datetime.fromisoformat(backoff_raw)
        except (TypeError, ValueError):
            state.pop("delete_backoff_until", None)
            save_state(state)
        else:
            if now < backoff_until:
                remaining = max(
                    1,
                    int(
                        (
                            backoff_until - now
                        ).total_seconds()
                    ),
                )

                logger.info(
                    "Удаление находится в global backoff ещё %s сек. "
                    "VK API не вызывается.",
                    remaining,
                )
                return

            state.pop("delete_backoff_until", None)
            save_state(state)

    if accounts is None:
        config = load_config()

        accounts = [
            acc
            for acc in config["vk_accounts"]
            if is_account_runtime_ready(acc)
        ]

    # Short local snapshot only.
    # POSTS is released before any ACCOUNT lock.
    with published_posts_shared():
        snapshot_posts = load_published_posts()

    if not snapshot_posts:
        logger.info("Очередь удаления пуста.")
        return

    settings = load_settings()

    delete_delay = timedelta(
        minutes=settings["delete_delay"]
    )

    max_tasks_per_run = 3
    request_pause_seconds = 2.0
    flood_backoff_seconds = 15 * 60

    deleted_count = 0
    committed_count = 0
    attempted_count = 0
    flood_stopped = False

    for post in snapshot_posts:
        if attempted_count >= max_tasks_per_run:
            logger.info(
                "Достигнут лимит обработки удаления за проход: "
                "%s задач.",
                max_tasks_per_run,
            )
            break

        if not isinstance(post, dict):
            continue

        if post.get("status") == "deleted":
            continue

        created_at_raw = (
            post.get("created_at")
            or post.get("published_on_wall_at")
        )

        try:
            created_at = datetime.fromisoformat(
                created_at_raw
            )
        except (TypeError, ValueError):
            logger.warning(
                "У поста %s_%s нет корректного created_at. "
                "Пропускаем.",
                post.get("owner_id"),
                post.get("post_id"),
            )
            continue

        if now - created_at < delete_delay:
            continue

        account_user_id = post.get(
            "account_user_id"
        )

        try:
            owner_id = int(post["owner_id"])
            post_id = int(post["post_id"])
        except (KeyError, TypeError, ValueError):
            logger.warning(
                "Некорректная задача удаления: "
                "owner_id=%r post_id=%r",
                post.get("owner_id"),
                post.get("post_id"),
            )
            continue

        original_status = post.get(
            "status",
            "pending",
        )

        # GLOBAL ORDER:
        #
        # ACCOUNT SH
        #   -> VK network operation
        #   -> POSTS EX fresh conditional commit
        #
        # Never POSTS -> ACCOUNT.
        with account_lifecycle_shared(
            account_user_id
        ):
            fresh_delete_account = (
                get_fresh_runtime_account(
                    account_user_id
                )
            )

            if fresh_delete_account is None:
                logger.warning(
                    "DELETE DEFERRED | Post %s_%s | "
                    "account_user_id %s отсутствует, выключен "
                    "или не готов к VK API.",
                    owner_id,
                    post_id,
                    account_user_id,
                )
                continue

            token = fresh_delete_account["token"]

            if not token:
                logger.warning(
                    "Для задачи %s_%s не найден активный "
                    "account_user_id/token. VK API не вызывается.",
                    owner_id,
                    post_id,
                )
                continue

            attempted_count += 1
            result = None

            try:
                vk = create_vk_api(token)

                status = check_post_status(
                    vk,
                    owner_id,
                    post_id,
                )

                if status == "not_found":
                    result = {
                        "status": "deleted",
                        "deleted_at": (
                            datetime.now().isoformat(
                                timespec="seconds"
                            )
                        ),
                        "delete_result": (
                            "already_missing"
                        ),
                    }

                elif status == "published":
                    vk_call_with_retry(
                        vk.wall.delete,
                        owner_id=owner_id,
                        post_id=post_id,
                    )

                    result = {
                        "status": "deleted",
                        "deleted_at": (
                            datetime.now().isoformat(
                                timespec="seconds"
                            )
                        ),
                        "delete_result": (
                            "deleted_by_bot"
                        ),
                    }

                    logger.info(
                        "Удалён пост %s из группы %s",
                        post_id,
                        owner_id,
                    )

                elif status == "flood":
                    flood_stopped = True

                    backoff_until = (
                        datetime.now()
                        + timedelta(
                            seconds=flood_backoff_seconds
                        )
                    )

                    state = load_state()

                    state["delete_backoff_until"] = (
                        backoff_until.isoformat(
                            timespec="seconds"
                        )
                    )

                    save_state(state)

                    logger.warning(
                        "VK Flood control при удалении. "
                        "Global backoff установлен до %s.",
                        backoff_until.isoformat(
                            timespec="seconds"
                        ),
                    )

                # Critical lifecycle coupling:
                # remote success/not-found and local queue
                # confirmation remain inside ACCOUNT SH.
                if result is not None:
                    with published_posts_exclusive():
                        current_posts = (
                            load_published_posts()
                        )

                        matches = []

                        for current_post in current_posts:
                            if not isinstance(
                                current_post,
                                dict,
                            ):
                                continue

                            try:
                                current_owner_id = int(
                                    current_post.get(
                                        "owner_id"
                                    )
                                )

                                current_post_id = int(
                                    current_post.get(
                                        "post_id"
                                    )
                                )
                            except (
                                TypeError,
                                ValueError,
                            ):
                                continue

                            if (
                                current_owner_id == owner_id
                                and current_post_id == post_id
                                and str(
                                    current_post.get(
                                        "account_user_id"
                                    )
                                )
                                == str(account_user_id)
                            ):
                                matches.append(
                                    current_post
                                )

                        # Duplicate/missing identity:
                        # fail closed and do not mutate.
                        if len(matches) != 1:
                            logger.warning(
                                "DELETE COMMIT SKIPPED | "
                                "Post %s_%s | "
                                "expected exactly one queue entry, "
                                "found %s.",
                                owner_id,
                                post_id,
                                len(matches),
                            )

                        else:
                            current_post = matches[0]

                            current_status = (
                                current_post.get(
                                    "status",
                                    "pending",
                                )
                            )

                            # Conditional commit prevents a stale
                            # snapshot from overwriting newer state.
                            if (
                                current_status
                                != original_status
                            ):
                                logger.warning(
                                    "DELETE COMMIT SKIPPED | "
                                    "Post %s_%s | "
                                    "queue status changed concurrently "
                                    "from %r to %r.",
                                    owner_id,
                                    post_id,
                                    original_status,
                                    current_status,
                                )

                            else:
                                current_post["status"] = (
                                    result["status"]
                                )

                                current_post["deleted_at"] = (
                                    result["deleted_at"]
                                )

                                current_post["delete_result"] = (
                                    result["delete_result"]
                                )

                                save_published_posts(
                                    current_posts
                                )

                                committed_count += 1
                                deleted_count += 1

                if flood_stopped:
                    break

                time.sleep(request_pause_seconds)

            except vk_api.exceptions.ApiError as e:
                logger.warning(
                    "Не удалось удалить %s_%s: "
                    "VK Error %s: %s",
                    owner_id,
                    post_id,
                    e.code,
                    e,
                )

                if e.code == 9:
                    flood_stopped = True

                    backoff_until = (
                        datetime.now()
                        + timedelta(
                            seconds=flood_backoff_seconds
                        )
                    )

                    state = load_state()

                    state["delete_backoff_until"] = (
                        backoff_until.isoformat(
                            timespec="seconds"
                        )
                    )

                    save_state(state)

                    logger.warning(
                        "VK Error 9 при удалении. "
                        "Global backoff установлен до %s.",
                        backoff_until.isoformat(
                            timespec="seconds"
                        ),
                    )

                    break

                time.sleep(request_pause_seconds)

            except Exception as e:
                logger.exception(
                    "Ошибка удаления %s_%s: %s",
                    owner_id,
                    post_id,
                    e,
                )

                time.sleep(request_pause_seconds)

    # Cleanup is standalone POSTS EX.
    # No ACCOUNT lock is acquired from this section.
    with published_posts_exclusive():
        current_posts = load_published_posts()
        cleaned = cleanup_deleted_posts(
            current_posts
        )

        if len(cleaned) != len(current_posts):
            save_published_posts(cleaned)

        queue_size = len(cleaned)

    logger.info(
        "Проверка удаления завершена. "
        "Попыток: %s. Удалено/закрыто и подтверждено: %s. "
        "Локально подтверждено: %s. "
        "В очереди: %s. Flood-stop: %s",
        attempted_count,
        deleted_count,
        committed_count,
        queue_size,
        flood_stopped,
    )



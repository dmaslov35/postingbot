def recover_confirmed_publications() -> Dict[str, int]:
    """
    Recover journal operations whose remote VK post is durably CONFIRMED
    but whose local publication queue may not yet be durably committed.

    This recovery is strictly local:
      - it never calls VK;
      - INTENT is not republished;
      - UNCERTAIN is not republished;
      - FAILED and COMMITTED are terminal/no-op;
      - only CONFIRMED may repair the local queue.

    Journal and POSTS locks are never held simultaneously.
    """
    events = load_events(
        PUBLICATION_JOURNAL_PATH,
        PUBLICATION_JOURNAL_LOCK_PATH,
    )

    latest = latest_by_operation(events)

    stats = {
        "confirmed_seen": 0,
        "queue_inserted": 0,
        "already_present": 0,
        "committed": 0,
    }

    for operation_id, event in latest.items():
        if event.get("event") != "CONFIRMED":
            continue

        stats["confirmed_seen"] += 1

        try:
            owner_id = int(event["owner_id"])
            post_id = int(event["post_id"])
        except (KeyError, TypeError, ValueError) as e:
            raise RuntimeError(
                "Invalid CONFIRMED journal identity "
                f"for operation {operation_id}"
            ) from e

        # Recover immutable account identity from the operation's INTENT.
        operation_events = [
            item
            for item in events
            if item.get("operation_id") == operation_id
        ]

        intents = [
            item
            for item in operation_events
            if item.get("event") == "INTENT"
        ]

        if len(intents) != 1:
            raise RuntimeError(
                "Expected exactly one INTENT for confirmed operation "
                f"{operation_id}, got {len(intents)}"
            )

        intent = intents[0]

        if "account_user_id" not in intent:
            raise RuntimeError(
                "INTENT missing account_user_id for operation "
                f"{operation_id}"
            )

        account_user_id = intent["account_user_id"]

        inserted = False

        # Fresh RMW under POSTS_EX.
        with published_posts_exclusive():
            posts = load_published_posts()

            matches = []

            for index, post in enumerate(posts):
                try:
                    same_identity = (
                        int(post["owner_id"]) == owner_id
                        and int(post["post_id"]) == post_id
                    )
                except (KeyError, TypeError, ValueError) as e:
                    raise RuntimeError(
                        "Invalid publication queue identity "
                        f"at index {index}"
                    ) from e

                if same_identity:
                    matches.append(post)

            if len(matches) > 1:
                raise RuntimeError(
                    "Duplicate publication queue identity "
                    f"owner_id={owner_id}, post_id={post_id}"
                )

            if len(matches) == 0:
                posts.append(
                    {
                        "owner_id": owner_id,
                        "post_id": post_id,
                        "created_at": datetime.now().isoformat(
                            timespec="seconds"
                        ),
                        "status": "pending",
                        "account_user_id": account_user_id,
                    }
                )

                # atomic_write_json includes file fsync,
                # replace and parent-directory fsync in V4.
                save_published_posts(posts)
                inserted = True

        # POSTS lock is released before taking JOURNAL_EX.
        append_event(
            PUBLICATION_JOURNAL_PATH,
            PUBLICATION_JOURNAL_LOCK_PATH,
            make_committed(
                operation_id=operation_id,
                owner_id=owner_id,
                post_id=post_id,
            ),
        )

        if inserted:
            stats["queue_inserted"] += 1
        else:
            stats["already_present"] += 1

        stats["committed"] += 1

        logger.info(
            "PUBLICATION RECOVERY COMMITTED | "
            "Operation %s | Group %s | Post %s | "
            "Queue inserted=%s",
            operation_id,
            owner_id,
            post_id,
            inserted,
        )

    return stats


def save_new_post(
    owner_id: int,
    post_id: int,
    account: Dict[str, Any],
) -> None:
    with published_posts_exclusive():
        posts = load_published_posts()

        posts.append(
            {
                "owner_id": owner_id,
                "post_id": post_id,
                "created_at": datetime.now().isoformat(timespec="seconds"),
                "status": "pending",
                "account_user_id": account.get("user_id"),
            }
        )

        save_published_posts(posts)


def classify_api_error(code: int) -> str:
    if code in AUTH_ERROR_CODES:
        return "auth"
    if code == 214:
        return "group_limit"
    if code in ACCOUNT_COOLDOWN_ERROR_CODES:
        return "temporary_account"
    return "api"


def handle_vk_api_error(
    e: vk_api.exceptions.ApiError,
    account: Dict[str, Any],
    account_index: int,
    group_id: int,
    state: Dict[str, Any],
) -> None:
    error_type = classify_api_error(e.code)
    account_id = account.get("user_id", account_index)

    logger.warning(
        "VK Error %s | Account %s | Group %s | %s",
        e.code,
        account_id,
        group_id,
        e,
    )

    add_error_stat(
        account_id=account_id,
        group_id=group_id,
        error_type=error_type,
        error_text=str(e),
        error_code=e.code,
    )

    if error_type == "auth":
        set_account_status(account_id, f"AUTH_ERROR_{e.code}")
        # Ошибка авторизации редко проходит сама быстро.
        set_account_cooldown(
            state,
            account,
            account_index,
            6 * 60 * 60,
        )

    elif error_type == "temporary_account":
        set_account_status(account_id, f"TEMP_ERROR_{e.code}")
        set_account_cooldown(
            state,
            account,
            account_index,
            DEFAULT_ACCOUNT_COOLDOWN_SECONDS,
        )

    elif error_type == "group_limit":
        # Error 214 относится к конкретной публикации/стене,
        # поэтому не помечаем весь аккаунт как нерабочий.
        set_group_status(group_id, "LIMIT_214")

    else:
        set_group_status(group_id, f"VK_ERROR_{e.code}")



def get_fresh_runtime_account(
    user_id: Any,
) -> Optional[Dict[str, Any]]:
    """
    Reload config.json and return the current runtime-ready
    account matching user_id.

    Fail closed. No VK API calls.
    """
    if isinstance(user_id, bool):
        return None

    try:
        normalized_user_id = int(
            str(user_id).strip()
        )
    except (TypeError, ValueError):
        return None

    if normalized_user_id <= 0:
        return None

    try:
        fresh_config = load_config()
    except Exception:
        logger.exception(
            "Не удалось перечитать config.json "
            "перед VK-действием | Account %s",
            normalized_user_id,
        )
        return None

    accounts = fresh_config.get(
        "vk_accounts",
        [],
    )

    if not isinstance(accounts, list):
        return None

    matches = []

    for candidate in accounts:
        if not isinstance(candidate, dict):
            continue

        candidate_id = candidate.get("user_id")

        if isinstance(candidate_id, bool):
            continue

        try:
            candidate_id = int(
                str(candidate_id).strip()
            )
        except (TypeError, ValueError):
            continue

        if candidate_id == normalized_user_id:
            matches.append(candidate)

    # Duplicate UID must fail closed.
    if len(matches) != 1:
        return None

    fresh_account = matches[0]

    if not is_account_runtime_ready(
        fresh_account
    ):
        return None

    return fresh_account


def publish_one_post(
    account: Dict[str, Any],
    account_index: int,
    group_id: int,
    messages: List[str],
    state: Dict[str, Any],
) -> bool:
    account_id = account.get("user_id", account_index)

    # Final fail-closed revalidation immediately before
    # constructing the VK API object. The account selected
    # by main() may already be stale.
    with account_lifecycle_shared(account_id):
        fresh_account = get_fresh_runtime_account(account_id)

        if fresh_account is None:
            logger.warning(
                "PUBLISH CANCELLED | Account %s "
                "больше не существует, выключен "
                "или не готов к VK API.",
                account_id,
            )
            return False

        # From this point use ONLY the fresh snapshot.
        account = fresh_account
        account_id = account["user_id"]

        operation_id = None
        publication_state = "PRE_INTENT"

        try:
            vk = create_vk_api(account["token"])

            random_message = random.choice(messages)
            account_phone = account.get("phone", "Не указан")
            current_dates = generate_dates()

            final_message = (
                random_message
                .replace("{PHONE}", str(account_phone))
                .replace("{DATES}", current_dates)
            )

            operation_id = new_operation_id()
            publication_state = "INTENT_PENDING"

            # Durable intent MUST exist before the remote side effect.
            append_event(
                PUBLICATION_JOURNAL_PATH,
                PUBLICATION_JOURNAL_LOCK_PATH,
                make_intent(
                    operation_id=operation_id,
                    account_user_id=account_id,
                    owner_id=group_id,
                    message=final_message,
                ),
            )
            publication_state = "INTENT_DURABLE"

            # IMPORTANT:
            # wall.post is deliberately NOT passed through
            # vk_call_with_retry. Any non-ApiError exception
            # after this point is ambiguous and must never
            # trigger an automatic second wall.post.
            publication_state = "REMOTE_ATTEMPTED"

            response = vk.wall.post(
                owner_id=group_id,
                message=final_message,
            )

            post_id = int(response["post_id"])

            append_event(
                PUBLICATION_JOURNAL_PATH,
                PUBLICATION_JOURNAL_LOCK_PATH,
                make_confirmed(
                    operation_id=operation_id,
                    owner_id=group_id,
                    post_id=post_id,
                ),
            )
            publication_state = "CONFIRMED_DURABLE"

            # Existing queue transaction remains authoritative
            # for deletion scheduling.
            save_new_post(
                owner_id=group_id,
                post_id=post_id,
                account=account,
            )

            append_event(
                PUBLICATION_JOURNAL_PATH,
                PUBLICATION_JOURNAL_LOCK_PATH,
                make_committed(
                    operation_id=operation_id,
                    owner_id=group_id,
                    post_id=post_id,
                ),
            )
            publication_state = "COMMITTED_DURABLE"

            increment_success(account_id, group_id)

            logger.info(
                "POSTED | Account %s | Group %s | Post ID %s | "
                "Phone %s | Dates %s | Operation %s",
                account_id,
                group_id,
                post_id,
                account_phone,
                current_dates,
                operation_id,
            )

            return True

        except KeyError as e:
            # A KeyError before wall.post is definite local failure.
            # A KeyError after wall.post (for example missing post_id
            # in a response) is ambiguous and must not be marked FAILED.
            if operation_id is not None:
                try:
                    if publication_state == "REMOTE_ATTEMPTED":
                        append_event(
                            PUBLICATION_JOURNAL_PATH,
                            PUBLICATION_JOURNAL_LOCK_PATH,
                            make_uncertain(
                                operation_id=operation_id,
                                error_type="KeyError",
                            ),
                        )
                    elif publication_state == "INTENT_DURABLE":
                        append_event(
                            PUBLICATION_JOURNAL_PATH,
                            PUBLICATION_JOURNAL_LOCK_PATH,
                            make_failed(
                                operation_id=operation_id,
                                error_type="KeyError",
                            ),
                        )
                    elif publication_state == "CONFIRMED_DURABLE":
                        logger.error(
                            "LOCAL FAILURE AFTER CONFIRMED | "
                            "Operation %s remains CONFIRMED for recovery",
                            operation_id,
                        )
                except Exception:
                    logger.exception(
                        "PUBLICATION JOURNAL WRITE ERROR | "
                        "Operation %s",
                        operation_id,
                    )

            logger.error(
                "В аккаунте %s отсутствует поле %s",
                account_id,
                e,
            )

            set_account_status(account_id, "CONFIG_ERROR")
            return False

        except vk_api.exceptions.ApiError as e:
            # VK ApiError is treated as a definite API rejection.
            # It is intentionally not retried for wall.post.
            if operation_id is not None:
                try:
                    if publication_state in {
                        "INTENT_DURABLE",
                        "REMOTE_ATTEMPTED",
                    }:
                        append_event(
                            PUBLICATION_JOURNAL_PATH,
                            PUBLICATION_JOURNAL_LOCK_PATH,
                            make_failed(
                                operation_id=operation_id,
                                error_type="ApiError",
                            ),
                        )
                    elif publication_state == "CONFIRMED_DURABLE":
                        logger.error(
                            "LOCAL/API FAILURE AFTER CONFIRMED | "
                            "Operation %s remains CONFIRMED for recovery",
                            operation_id,
                        )
                except Exception:
                    logger.exception(
                        "PUBLICATION JOURNAL WRITE ERROR | "
                        "Operation %s",
                        operation_id,
                    )

            handle_vk_api_error(
                e=e,
                account=account,
                account_index=account_index,
                group_id=group_id,
                state=state,
            )

            return False

        except Exception as e:
            # Once wall.post has been attempted, every generic exception
            # is conservatively ambiguous. Never automatically republish.
            if operation_id is not None:
                try:
                    if publication_state == "REMOTE_ATTEMPTED":
                        append_event(
                            PUBLICATION_JOURNAL_PATH,
                            PUBLICATION_JOURNAL_LOCK_PATH,
                            make_uncertain(
                                operation_id=operation_id,
                                error_type=type(e).__name__,
                            ),
                        )
                    elif publication_state == "INTENT_DURABLE":
                        append_event(
                            PUBLICATION_JOURNAL_PATH,
                            PUBLICATION_JOURNAL_LOCK_PATH,
                            make_failed(
                                operation_id=operation_id,
                                error_type=type(e).__name__,
                            ),
                        )
                    elif publication_state == "CONFIRMED_DURABLE":
                        logger.error(
                            "LOCAL FAILURE AFTER CONFIRMED | "
                            "Operation %s remains CONFIRMED for recovery",
                            operation_id,
                        )
                except Exception:
                    logger.exception(
                        "PUBLICATION JOURNAL WRITE ERROR | "
                        "Operation %s",
                        operation_id,
                    )

            logger.exception(
                "Системная/сетевая ошибка | "
                "Account %s | Group %s: %s",
                account_id,
                group_id,
                e,
            )

            add_error_stat(
                account_id=account_id,
                group_id=group_id,
                error_type="system",
                error_text=str(e),
            )

            set_account_cooldown(
                state,
                account,
                account_index,
                5 * 60,
            )

            return False




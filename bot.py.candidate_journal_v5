def load_published_posts() -> List[Dict[str, Any]]:
    """
    Strict fail-closed loader for the publication queue.

    Missing, unreadable, malformed or structurally invalid queue data
    must never be interpreted as an empty queue.
    """
    try:
        with open(POSTS_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
    except FileNotFoundError as e:
        raise RuntimeError(
            f"Published-posts queue is missing: {POSTS_FILE}"
        ) from e
    except (OSError, json.JSONDecodeError) as e:
        raise RuntimeError(
            f"Published-posts queue cannot be loaded: {POSTS_FILE}"
        ) from e

    if not isinstance(data, list):
        raise RuntimeError(
            "Published-posts queue root must be a JSON list"
        )

    for index, item in enumerate(data):
        if not isinstance(item, dict):
            raise RuntimeError(
                "Published-posts queue item "
                f"{index} must be a JSON object"
            )

    return data



